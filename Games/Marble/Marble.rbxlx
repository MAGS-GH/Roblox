  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="15">
      <Properties>
        <string name="Name">CourseBuilder</string>
        <string name="Source"><![CDATA[--[[
	Marble course builder.
	Heights are FLOOR TOP (surface the marble rolls on).
	Segments overlap slightly so seams never leave gaps.
]]

local ObstacleEngine = require(script.Parent:WaitForChild("ObstacleEngine"))

export type CheckpointRecord = {
	index: number,
	position: Vector3,
}

local CourseBuilder = {}

local FLOOR = 2
local WALL_T = 1.5
local WALL_H = 7
local TRACK = 22
local OVERLAP = 2

local GRASS = Color3.fromRGB(92, 148, 98)
local GRASS_DARK = Color3.fromRGB(78, 128, 88)
local WOOD = Color3.fromRGB(158, 118, 72)
local PLANKS = Color3.fromRGB(170, 135, 85)
local STONE = Color3.fromRGB(112, 118, 128)
local CONCRETE = Color3.fromRGB(130, 136, 142)
local ACCENT = Color3.fromRGB(70, 88, 110)
local GOAL_COLOR = Color3.fromRGB(236, 196, 64)
local START_COLOR = Color3.fromRGB(72, 168, 118)

local function part(
	parent: Instance,
	props: {
		Name: string?,
		Size: Vector3,
		CFrame: CFrame,
		Color: Color3?,
		Material: Enum.Material?,
		Transparency: number?,
		CanCollide: boolean?,
	}
): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "Part"
	p.Anchored = true
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color or GRASS
	p.Material = props.Material or Enum.Material.Grass
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Transparency = props.Transparency or 0
	p.Parent = parent
	return p
end

local function wall(parent: Instance, size: Vector3, cf: CFrame, color: Color3?): Part
	return part(parent, {
		Name = "Wall",
		Size = size,
		CFrame = cf,
		Color = color or ACCENT,
		Material = Enum.Material.Slate,
	})
end

local function label(parent: BasePart, text: string, color: Color3, studs: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = studs or 18
	gui.Parent = parent

	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.TextColor3 = color
	t.TextStrokeTransparency = 0.5
	t.Text = text
	t.Parent = gui
end

-- Floor whose TOP surface is at height `topY`
local function floorBox(
	parent: Instance,
	name: string,
	cx: number,
	cz: number,
	sx: number,
	sz: number,
	topY: number,
	color: Color3?,
	material: Enum.Material?
): Part
	return part(parent, {
		Name = name,
		Size = Vector3.new(sx, FLOOR, sz),
		CFrame = CFrame.new(cx, topY - FLOOR / 2, cz),
		Color = color or GRASS,
		Material = material or Enum.Material.Grass,
	})
end

-- Ramp along +X: top surface from (x0, y0) to (x1, y1) at fixed z
local function rampX(
	parent: Instance,
	name: string,
	x0: number,
	x1: number,
	z: number,
	width: number,
	y0: number,
	y1: number,
	color: Color3?,
	material: Enum.Material?
): Part
	local dx = x1 - x0
	local dy = y1 - y0
	local dist = math.sqrt(dx * dx + dy * dy)
	local angle = math.atan2(dy, dx)
	local mid = Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, z)
	local cf = CFrame.new(mid) * CFrame.Angles(0, 0, angle) * CFrame.new(0, -FLOOR / 2, 0)
	return part(parent, {
		Name = name,
		Size = Vector3.new(dist, FLOOR, width),
		CFrame = cf,
		Color = color or PLANKS,
		Material = material or Enum.Material.WoodPlanks,
	})
end

-- Ramp along +Z: top surface from (z0, y0) to (z1, y1) at fixed x
local function rampZ(
	parent: Instance,
	name: string,
	z0: number,
	z1: number,
	x: number,
	width: number,
	y0: number,
	y1: number,
	color: Color3?,
	material: Enum.Material?
): Part
	local dz = z1 - z0
	local dy = y1 - y0
	local dist = math.sqrt(dz * dz + dy * dy)
	local angle = math.atan2(dy, dz)
	local mid = Vector3.new(x, (y0 + y1) / 2, (z0 + z1) / 2)
	local cf = CFrame.new(mid) * CFrame.Angles(-angle, 0, 0) * CFrame.new(0, -FLOOR / 2, 0)
	return part(parent, {
		Name = name,
		Size = Vector3.new(width, FLOOR, dist),
		CFrame = cf,
		Color = color or PLANKS,
		Material = material or Enum.Material.WoodPlanks,
	})
end

local function wallsAlongZ(parent: Instance, cx: number, zMid: number, length: number, topY: number, trackWidth: number)
	local wallY = topY + WALL_H / 2
	local xL = cx - trackWidth / 2 - WALL_T / 2
	local xR = cx + trackWidth / 2 + WALL_T / 2
	wall(parent, Vector3.new(WALL_T, WALL_H, length), CFrame.new(xL, wallY, zMid))
	wall(parent, Vector3.new(WALL_T, WALL_H, length), CFrame.new(xR, wallY, zMid))
end

local function wallsAlongX(parent: Instance, cz: number, xMid: number, length: number, topY: number, trackWidth: number)
	local wallY = topY + WALL_H / 2
	local zL = cz - trackWidth / 2 - WALL_T / 2
	local zR = cz + trackWidth / 2 + WALL_T / 2
	wall(parent, Vector3.new(length, WALL_H, WALL_T), CFrame.new(xMid, wallY, zL))
	wall(parent, Vector3.new(length, WALL_H, WALL_T), CFrame.new(xMid, wallY, zR))
end

-- Walls on a ramp along X (same angle as floor)
local function rampWallsX(
	parent: Instance,
	x0: number,
	x1: number,
	z: number,
	trackWidth: number,
	y0: number,
	y1: number
)
	local dx = x1 - x0
	local dy = y1 - y0
	local dist = math.sqrt(dx * dx + dy * dy)
	local angle = math.atan2(dy, dx)
	local mid = Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, z)
	local base = CFrame.new(mid) * CFrame.Angles(0, 0, angle)
	local xL = -trackWidth / 2 - WALL_T / 2
	local xR = trackWidth / 2 + WALL_T / 2
	-- Local: X along ramp, Y up from surface, Z sideways
	wall(parent, Vector3.new(dist, WALL_H, WALL_T), base * CFrame.new(0, WALL_H / 2, xL))
	wall(parent, Vector3.new(dist, WALL_H, WALL_T), base * CFrame.new(0, WALL_H / 2, xR))
end

local function rampWallsZ(
	parent: Instance,
	z0: number,
	z1: number,
	x: number,
	trackWidth: number,
	y0: number,
	y1: number
)
	local dz = z1 - z0
	local dy = y1 - y0
	local dist = math.sqrt(dz * dz + dy * dy)
	local angle = math.atan2(dy, dz)
	local mid = Vector3.new(x, (y0 + y1) / 2, (z0 + z1) / 2)
	local base = CFrame.new(mid) * CFrame.Angles(-angle, 0, 0)
	local xL = -trackWidth / 2 - WALL_T / 2
	local xR = trackWidth / 2 + WALL_T / 2
	wall(parent, Vector3.new(WALL_T, WALL_H, dist), base * CFrame.new(xL, WALL_H / 2, 0))
	wall(parent, Vector3.new(WALL_T, WALL_H, dist), base * CFrame.new(xR, WALL_H / 2, 0))
end

local function plazaWalls(
	parent: Instance,
	cx: number,
	cz: number,
	sx: number,
	sz: number,
	topY: number,
	open: { north: boolean?, south: boolean?, east: boolean?, west: boolean? }
)
	-- north = -Z, south = +Z, west = -X, east = +X
	local wallY = topY + WALL_H / 2
	local halfX = sx / 2
	local halfZ = sz / 2

	if not open.north then
		wall(parent, Vector3.new(sx + WALL_T, WALL_H, WALL_T), CFrame.new(cx, wallY, cz - halfZ - WALL_T / 2))
	else
		-- side stubs leaving a TRACK-wide gap
		local gap = TRACK / 2
		local side = halfX - gap
		if side > 1 then
			wall(parent, Vector3.new(side, WALL_H, WALL_T), CFrame.new(cx - gap - side / 2, wallY, cz - halfZ - WALL_T / 2))
			wall(parent, Vector3.new(side, WALL_H, WALL_T), CFrame.new(cx + gap + side / 2, wallY, cz - halfZ - WALL_T / 2))
		end
	end

	if not open.south then
		wall(parent, Vector3.new(sx + WALL_T, WALL_H, WALL_T), CFrame.new(cx, wallY, cz + halfZ + WALL_T / 2))
	else
		local gap = TRACK / 2
		local side = halfX - gap
		if side > 1 then
			wall(parent, Vector3.new(side, WALL_H, WALL_T), CFrame.new(cx - gap - side / 2, wallY, cz + halfZ + WALL_T / 2))
			wall(parent, Vector3.new(side, WALL_H, WALL_T), CFrame.new(cx + gap + side / 2, wallY, cz + halfZ + WALL_T / 2))
		end
	end

	if not open.west then
		wall(parent, Vector3.new(WALL_T, WALL_H, sz + WALL_T), CFrame.new(cx - halfX - WALL_T / 2, wallY, cz))
	else
		local gap = TRACK / 2
		local side = halfZ - gap
		if side > 1 then
			wall(parent, Vector3.new(WALL_T, WALL_H, side), CFrame.new(cx - halfX - WALL_T / 2, wallY, cz - gap - side / 2))
			wall(parent, Vector3.new(WALL_T, WALL_H, side), CFrame.new(cx - halfX - WALL_T / 2, wallY, cz + gap + side / 2))
		end
	end

	if not open.east then
		wall(parent, Vector3.new(WALL_T, WALL_H, sz + WALL_T), CFrame.new(cx + halfX + WALL_T / 2, wallY, cz))
	else
		local gap = TRACK / 2
		local side = halfZ - gap
		if side > 1 then
			wall(parent, Vector3.new(WALL_T, WALL_H, side), CFrame.new(cx + halfX + WALL_T / 2, wallY, cz - gap - side / 2))
			wall(parent, Vector3.new(WALL_T, WALL_H, side), CFrame.new(cx + halfX + WALL_T / 2, wallY, cz + gap + side / 2))
		end
	end
end

-- Synlig checkpoint + usynlig trigger; server gemmer position til respawn
local function addCheckpoint(
	parent: Instance,
	index: number,
	cx: number,
	cz: number,
	topY: number,
	checkpoints: { CheckpointRecord }
)
	local pad = floorBox(parent, "Checkpoint_" .. index, cx, cz, 18, 18, topY, Color3.fromRGB(80, 160, 220), Enum.Material.Neon)
	label(pad, "CP " .. index, Color3.fromRGB(255, 255, 255), 10)

	local trigger = part(parent, {
		Name = "CheckpointTrigger",
		Size = Vector3.new(16, 8, 16),
		CFrame = CFrame.new(cx, topY + 4, cz),
		Transparency = 1,
		CanCollide = false,
	})
	trigger:SetAttribute("CheckpointIndex", index)

	local spawnY = topY + 5
	table.insert(checkpoints, {
		index = index,
		position = Vector3.new(cx, spawnY, cz),
	})
end

function CourseBuilder.build(): (Folder, Attachment, BasePart, { CheckpointRecord })
	local folder = Instance.new("Folder")
	folder.Name = "MarbleCourse"
	folder.Parent = workspace

	local checkpoints: { CheckpointRecord } = {}

	----------------------------------------------------------------
	-- 1) START PLAZA
	----------------------------------------------------------------
	local H0 = 4
	local start = floorBox(folder, "StartPad", 0, 0, 48, 48, H0, START_COLOR, Enum.Material.Grass)
	label(start, "START", Color3.fromRGB(255, 255, 255), 14)
	plazaWalls(folder, 0, 0, 48, 48, H0, { south = true })

	local spawnAttachment = Instance.new("Attachment")
	spawnAttachment.Name = "Spawn"
	spawnAttachment.Position = Vector3.new(0, 8, 0)
	spawnAttachment.Parent = start

	----------------------------------------------------------------
	-- 2) LONG MEADOW (+Z)
	----------------------------------------------------------------
	local meadowLen = 140
	local meadowZ0 = 24 - OVERLAP
	local meadowZ1 = meadowZ0 + meadowLen
	local meadowMid = (meadowZ0 + meadowZ1) / 2
	floorBox(folder, "Meadow", 0, meadowMid, TRACK, meadowLen, H0, GRASS)
	wallsAlongZ(folder, 0, meadowMid, meadowLen, H0, TRACK)

	-- Gentle hill (up then down) — continuous surface
	local hillZ = meadowZ0 + 45
	rampZ(folder, "HillUp", hillZ, hillZ + 18, 0, TRACK - 1, H0, H0 + 5, GRASS_DARK, Enum.Material.Grass)
	rampWallsZ(folder, hillZ, hillZ + 18, 0, TRACK - 1, H0, H0 + 5)
	rampZ(folder, "HillDown", hillZ + 18 - OVERLAP, hillZ + 36, 0, TRACK - 1, H0 + 5, H0, GRASS_DARK, Enum.Material.Grass)
	rampWallsZ(folder, hillZ + 18 - OVERLAP, hillZ + 36, 0, TRACK - 1, H0 + 5, H0)

	addCheckpoint(folder, 1, 0, meadowZ0 + 55, H0, checkpoints)

	-- Svingende bro-stykke (small gaps — hop eller timing)
	for i = 1, 4 do
		local segZ = meadowZ0 + 78 + (i - 1) * 14
		floorBox(folder, "SwingSegment" .. i, (i % 2 == 0) and 4 or -4, segZ, 12, 12, H0, WOOD, Enum.Material.WoodPlanks)
	end
	-- Sikker midtersti så sving-pladerne ikke efterlader huller
	floorBox(folder, "MeadowCenter", 0, meadowZ0 + 92, 10, 58, H0, GRASS)
	wallsAlongZ(folder, 0, meadowZ0 + 92, 58, H0, TRACK)

	----------------------------------------------------------------
	-- 3) TURN PLAZA (to +X)
	----------------------------------------------------------------
	local turnCX, turnCZ = 18, meadowZ1 + 18 - OVERLAP
	floorBox(folder, "TurnPlaza", turnCX, turnCZ, 60, 44, H0, GRASS_DARK)
	plazaWalls(folder, turnCX, turnCZ, 60, 44, H0, { north = true, east = true })

	----------------------------------------------------------------
	-- 4) CANYON STRAIGHT (+X)
	----------------------------------------------------------------
	local canyonX0 = turnCX + 30 - OVERLAP
	local canyonLen = 175
	local canyonX1 = canyonX0 + canyonLen
	local canyonMid = (canyonX0 + canyonX1) / 2
	local canyonZ = turnCZ
	floorBox(folder, "Canyon", canyonMid, canyonZ, canyonLen, TRACK, H0, STONE, Enum.Material.Slate)
	wallsAlongX(folder, canyonZ, canyonMid, canyonLen, H0, TRACK)

	-- Side pillars as visual obstacles (not blocking center)
	for i = 1, 7 do
		local px = canyonX0 + 18 + (i - 1) * 22
		local side = if i % 2 == 0 then 1 else -1
		part(folder, {
			Name = "Pillar",
			Size = Vector3.new(3, 10, 3),
			CFrame = CFrame.new(px, H0 + 5, canyonZ + side * (TRACK / 2 - 2.5)),
			Color = Color3.fromRGB(90, 95, 105),
			Material = Enum.Material.Concrete,
		})
	end

	-- Bevægelige platforme over et "hul" i canyon (hop på dem i rækkefølge)
	local gapX = canyonX0 + 95
	part(folder, {
		Name = "CanyonGap",
		Size = Vector3.new(22, 1, TRACK - 4),
		CFrame = CFrame.new(gapX, H0 - 1.2, canyonZ),
		Color = Color3.fromRGB(40, 45, 55),
		Material = Enum.Material.Slate,
		CanCollide = false,
	})
	ObstacleEngine.addMovingPlatform(
		folder,
		Vector3.new(gapX - 8, H0 + 0.5, canyonZ),
		Vector3.new(10, 2, 14),
		"X",
		7,
		1.1
	)
	ObstacleEngine.addMovingPlatform(
		folder,
		Vector3.new(gapX, H0 + 0.5, canyonZ),
		Vector3.new(10, 2, 14),
		"Z",
		6,
		1.4
	)
	ObstacleEngine.addMovingPlatform(
		folder,
		Vector3.new(gapX + 8, H0 + 0.5, canyonZ),
		Vector3.new(10, 2, 14),
		"X",
		7,
		0.95
	)
	ObstacleEngine.addSpinner(folder, Vector3.new(gapX + 28, H0 + 4, canyonZ), 14, 6, 1.8)

	addCheckpoint(folder, 2, canyonX1 - 20, canyonZ, H0, checkpoints)

	----------------------------------------------------------------
	-- 4b) ZIGZAG (skift retning + smalle svinge)
	----------------------------------------------------------------
	local zigX, zigZ = canyonX1 - OVERLAP, canyonZ
	for i = 1, 6 do
		local len = 38
		if i % 2 == 1 then
			zigX += len / 2
			floorBox(folder, "ZigX" .. i, zigX, zigZ, len, TRACK - 2, H0, GRASS_DARK)
			wallsAlongX(folder, zigZ, zigX, len, H0, TRACK - 2)
			zigX += len / 2 - OVERLAP
		else
			zigZ += len / 2
			floorBox(folder, "ZigZ" .. i, zigX, zigZ, TRACK - 2, len, H0, STONE, Enum.Material.Slate)
			wallsAlongZ(folder, zigX, zigZ, len, H0, TRACK - 2)
			zigZ += len / 2 - OVERLAP
			ObstacleEngine.addBouncePad(
				folder,
				CFrame.new(zigX, H0 + 1, zigZ - len / 4),
				Vector3.new(8, 1, 8)
			)
		end
	end

	----------------------------------------------------------------
	-- 5) BIG CLIMB
	----------------------------------------------------------------
	local H1 = 26
	local climbX0 = zigX - OVERLAP
	local climbX1 = climbX0 + 85
	local climbZ = zigZ
	rampX(folder, "BigClimb", climbX0, climbX1, climbZ, TRACK, H0, H1, PLANKS)
	rampWallsX(folder, climbX0, climbX1, climbZ, TRACK, H0, H1)

	----------------------------------------------------------------
	-- 6) SKY PLAZA
	----------------------------------------------------------------
	local skyCX = climbX1 + 22 - OVERLAP
	local skyCZ = climbZ
	addCheckpoint(folder, 3, skyCX, skyCZ, H1, checkpoints)
	floorBox(folder, "SkyPlaza", skyCX, skyCZ, 52, 52, H1, CONCRETE, Enum.Material.Concrete)
	plazaWalls(folder, skyCX, skyCZ, 52, 52, H1, { west = true, south = true })

	-- Decorative corner blocks
	for _, ox in { -18, 18 } do
		for _, oz in { -18, 18 } do
			part(folder, {
				Name = "SkyDecor",
				Size = Vector3.new(4, 1.2, 4),
				CFrame = CFrame.new(skyCX + ox, H1 + 0.6, skyCZ + oz),
				Color = Color3.fromRGB(160, 165, 175),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			})
		end
	end

	----------------------------------------------------------------
	-- 7) ELEVATED RUN (+Z) + TURN WEST + BRIDGE
	----------------------------------------------------------------
	local elevZ0 = skyCZ + 26 - OVERLAP
	local elevLen = 75
	local elevZ1 = elevZ0 + elevLen
	local elevMid = (elevZ0 + elevZ1) / 2
	floorBox(folder, "ElevatedRun", skyCX, elevMid, TRACK, elevLen, H1, CONCRETE, Enum.Material.Concrete)
	wallsAlongZ(folder, skyCX, elevMid, elevLen, H1, TRACK)

	-- Turn plaza: arrive from north, leave west
	local turn2CX = skyCX
	local turn2CZ = elevZ1 + 22 - OVERLAP
	floorBox(folder, "HighTurn", turn2CX, turn2CZ, 56, 48, H1, STONE, Enum.Material.Concrete)
	plazaWalls(folder, turn2CX, turn2CZ, 56, 48, H1, { north = true, west = true })

	-- West corridor toward bridge start
	local westLen = 55
	local westX1 = turn2CX - 28 + OVERLAP -- plaza west edge ~ turn2CX-28
	local westX0 = westX1 - westLen
	local westMid = (westX0 + westX1) / 2
	floorBox(folder, "WestRun", westMid, turn2CZ, westLen, TRACK, H1, CONCRETE, Enum.Material.Concrete)
	wallsAlongX(folder, turn2CZ, westMid, westLen, H1, TRACK)
	ObstacleEngine.addSpinner(folder, Vector3.new(westMid, H1 + 5, turn2CZ), 16, 7, 2.2)
	ObstacleEngine.addIceStrip(
		folder,
		CFrame.new(westMid - 12, H1 - 1, turn2CZ),
		Vector3.new(24, FLOOR, TRACK - 4)
	)

	-- Bridge plaza
	local bridgePlazaCX = westX0 - 18 + OVERLAP
	local bridgePlazaCZ = turn2CZ
	floorBox(folder, "BridgePlaza", bridgePlazaCX, bridgePlazaCZ, 40, 40, H1, WOOD, Enum.Material.Wood)
	plazaWalls(folder, bridgePlazaCX, bridgePlazaCZ, 40, 40, H1, { east = true, south = true })

	----------------------------------------------------------------
	-- 8) NARROW BRIDGE (+Z)
	----------------------------------------------------------------
	local bridgeW = 12
	local bridgeZ0 = bridgePlazaCZ + 20 - OVERLAP
	local bridgeLen = 120
	local bridgeZ1 = bridgeZ0 + bridgeLen
	local bridgeMid = (bridgeZ0 + bridgeZ1) / 2
	floorBox(folder, "Bridge", bridgePlazaCX, bridgeMid, bridgeW, bridgeLen, H1, WOOD, Enum.Material.Wood)
	local railH = 2.8
	wall(
		folder,
		Vector3.new(1, railH, bridgeLen),
		CFrame.new(bridgePlazaCX - bridgeW / 2 - 0.5, H1 + railH / 2, bridgeMid),
		Color3.fromRGB(120, 90, 55)
	)
	wall(
		folder,
		Vector3.new(1, railH, bridgeLen),
		CFrame.new(bridgePlazaCX + bridgeW / 2 + 0.5, H1 + railH / 2, bridgeMid),
		Color3.fromRGB(120, 90, 55)
	)

	----------------------------------------------------------------
	-- 9) LANDING + DESCEND
	----------------------------------------------------------------
	local landCX = bridgePlazaCX
	local landCZ = bridgeZ1 + 22 - OVERLAP
	floorBox(folder, "Landing", landCX, landCZ, 44, 44, H1, CONCRETE, Enum.Material.Concrete)
	plazaWalls(folder, landCX, landCZ, 44, 44, H1, { north = true, east = true })
	addCheckpoint(folder, 4, landCX, landCZ, H1, checkpoints)

	local H2 = 10
	local descX0 = landCX + 22 - OVERLAP
	local descX1 = descX0 + 55
	rampX(folder, "Descend", descX0, descX1, landCZ, TRACK, H1, H2, PLANKS)
	rampWallsX(folder, descX0, descX1, landCZ, TRACK, H1, H2)

	----------------------------------------------------------------
	-- 10) FINAL APPROACH (+X then +Z to goal)
	----------------------------------------------------------------
	local finalX0 = descX1 - OVERLAP
	local finalLen = 110
	local finalX1 = finalX0 + finalLen
	local finalMid = (finalX0 + finalX1) / 2
	floorBox(folder, "FinalStraight", finalMid, landCZ, finalLen, TRACK, H2, GRASS)
	wallsAlongX(folder, landCZ, finalMid, finalLen, H2, TRACK)

	for i = 1, 4 do
		local hx = finalX0 + 18 + (i - 1) * 22
		part(folder, {
			Name = "HopPad",
			Size = Vector3.new(8, 1.5, 8),
			CFrame = CFrame.new(hx, H2 + 0.75, landCZ),
			Color = Color3.fromRGB(100, 160, 120),
			Material = Enum.Material.Grass,
		})
	end
	ObstacleEngine.addIceStrip(
		folder,
		CFrame.new(finalMid, H2 - 1, landCZ + 6),
		Vector3.new(finalLen - 10, FLOOR, 10)
	)
	ObstacleEngine.addSpinner(folder, Vector3.new(finalX1 - 25, H2 + 5, landCZ), 12, 6, 2.5)

	local preGoalCX = finalX1 + 20 - OVERLAP
	local preGoalCZ = landCZ
	floorBox(folder, "PreGoal", preGoalCX, preGoalCZ, 48, 48, H2, GRASS_DARK)
	plazaWalls(folder, preGoalCX, preGoalCZ, 48, 48, H2, { west = true, south = true })

	local approachZ0 = preGoalCZ + 24 - OVERLAP
	local approachLen = 85
	addCheckpoint(folder, 5, preGoalCX, preGoalCZ, H2, checkpoints)
	local approachZ1 = approachZ0 + approachLen
	local approachMid = (approachZ0 + approachZ1) / 2
	floorBox(folder, "GoalApproach", preGoalCX, approachMid, TRACK, approachLen, H2, GRASS)
	wallsAlongZ(folder, preGoalCX, approachMid, approachLen, H2, TRACK)

	----------------------------------------------------------------
	-- 11) GOAL
	----------------------------------------------------------------
	local goalCX = preGoalCX
	local goalCZ = approachZ1 + 22 - OVERLAP
	local goalPad = floorBox(folder, "GoalPad", goalCX, goalCZ, 44, 44, H2, GOAL_COLOR, Enum.Material.Neon)
	label(goalPad, "MÅL!", Color3.fromRGB(40, 28, 8), 12)
	plazaWalls(folder, goalCX, goalCZ, 44, 44, H2, { north = true })

	for i = 1, 12 do
		local angle = (i / 12) * math.pi * 2
		local x = goalCX + math.cos(angle) * 14
		local z = goalCZ + math.sin(angle) * 14
		part(folder, {
			Name = "GoalDecor",
			Size = Vector3.new(2.2, 1, 2.2),
			CFrame = CFrame.new(x, H2 + 0.5, z),
			Color = if i % 2 == 0 then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(25, 25, 25),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
	end

	local goal = part(folder, {
		Name = "GoalTrigger",
		Size = Vector3.new(28, 14, 28),
		CFrame = CFrame.new(goalCX, H2 + 7, goalCZ),
		Transparency = 1,
		CanCollide = false,
		Color = GOAL_COLOR,
		Material = Enum.Material.SmoothPlastic,
	})
	goal:SetAttribute("IsGoal", true)

	local light = Instance.new("PointLight")
	light.Brightness = 2.5
	light.Range = 50
	light.Color = Color3.fromRGB(255, 220, 120)
	light.Parent = goalPad

	ObstacleEngine.bindBouncePads(folder)
	ObstacleEngine.start()

	return folder, spawnAttachment, goal, checkpoints
end

return CourseBuilder
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">Game</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Game.server.luau (server)
	-------------------------
	Spillogik + SERVER-STYRET bevægelse.

	Hvorfor server-styring?
	- Client ApplyImpulse fejler ofte i Studio uden stabil network-owner.
	- Klienten sender kun input (retning + hop); server sætter VectorForce.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local CourseBuilder = require(script.Parent:WaitForChild("CourseBuilder"))

Players.CharacterAutoLoads = false

pcall(function()
	workspace.StreamingEnabled = false
end)

local _, spawnAttachment, goalTrigger, checkpoints = CourseBuilder.build()
local goalPosition = goalTrigger.Position
local checkpointCount = #checkpoints

local marbles: { [Player]: BasePart } = {}
local driveForces: { [Player]: VectorForce } = {}
local finished: { [Player]: boolean } = {}
local lastCheckpoint: { [Player]: number } = {}
local runStartedAt: { [Player]: number } = {}

-- Seneste input fra klient (world XZ, already normalized-ish)
local playerMove: { [Player]: Vector3 } = {}
local playerJump: { [Player]: boolean } = {}

local groundRay = RaycastParams.new()
groundRay.FilterType = Enum.RaycastFilterType.Exclude

local function getSpawnPosition(player: Player): Vector3
	local cpIndex = lastCheckpoint[player] or 0
	if cpIndex > 0 then
		for _, record in checkpoints do
			if record.index == cpIndex then
				return record.position
			end
		end
	end
	return spawnAttachment.WorldPosition
end

local function sendCourseInfo(player: Player)
	Remotes.CourseInfo:FireClient(player, {
		goalPosition = goalPosition,
		checkpointCount = checkpointCount,
	})
end

local function isGrounded(ball: BasePart): boolean
	groundRay.FilterDescendantsInstances = { ball }
	local radius = ball.Size.Y * 0.5
	local origin = ball.Position
	local direction = Vector3.new(0, -(radius + Config.Marble.GroundCheckPadding), 0)
	if workspace:Raycast(origin, direction, groundRay) then
		return true
	end
	local offsets = {
		Vector3.new(radius * 0.35, 0, 0),
		Vector3.new(-radius * 0.35, 0, 0),
		Vector3.new(0, 0, radius * 0.35),
		Vector3.new(0, 0, -radius * 0.35),
	}
	for _, offset in offsets do
		if workspace:Raycast(origin + offset, direction, groundRay) then
			return true
		end
	end
	return false
end

local function createMarble(player: Player, resetRunTimer: boolean?)
	local existing = marbles[player]
	if existing then
		existing:Destroy()
	end
	marbles[player] = nil
	driveForces[player] = nil
	playerMove[player] = Vector3.zero
	playerJump[player] = false

	local diameter = Config.Marble.Diameter
	local marble = Instance.new("Part")
	marble.Name = player.Name .. "_Marble"
	marble.Shape = Enum.PartType.Ball
	marble.Size = Vector3.new(diameter, diameter, diameter)
	marble.Color = Color3.fromHSV((player.UserId % 1000) / 1000, 0.65, 0.95)
	marble.Material = Enum.Material.SmoothPlastic
	marble.TopSurface = Enum.SurfaceType.Smooth
	marble.BottomSurface = Enum.SurfaceType.Smooth
	marble.CanCollide = true
	marble.Anchored = false
	marble:SetAttribute("IsMarble", true)
	marble.CustomPhysicalProperties = PhysicalProperties.new(
		Config.Marble.Density,
		Config.Marble.Friction,
		Config.Marble.Elasticity,
		1,
		1
	)

	local spawnPos = getSpawnPosition(player)
	local safeSpawn = spawnPos + Vector3.new(0, Config.Marble.Diameter * 0.5 + 2, 0)
	marble.CFrame = CFrame.new(safeSpawn)
	marble.AssemblyLinearVelocity = Vector3.zero
	marble.AssemblyAngularVelocity = Vector3.zero
	marble.Parent = workspace

	-- Drive force (server opdaterer Force hvert Heartbeat)
	local attachment = Instance.new("Attachment")
	attachment.Name = "DriveAttachment"
	attachment.Parent = marble

	local vectorForce = Instance.new("VectorForce")
	vectorForce.Name = "DriveForce"
	vectorForce.Attachment0 = attachment
	vectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
	vectorForce.ApplyAtCenterOfMass = true
	vectorForce.Force = Vector3.zero
	vectorForce.Parent = marble

	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.7
	highlight.OutlineTransparency = 0
	highlight.FillColor = marble.Color
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = marble

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(120, 28)
	billboard.StudsOffset = Vector3.new(0, diameter * 0.7, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = marble

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(1, 1)
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.Text = player.DisplayName
	nameLabel.Parent = billboard

	-- Klienten ejer fysikken → smooth lokal styring uden netværks-lag
	pcall(function()
		marble:SetNetworkOwner(player)
	end)

	-- DriveForce bruges ikke længere (klient kører velocity-arcade)
	vectorForce.Enabled = false
	vectorForce.Force = Vector3.zero


	marbles[player] = marble
	driveForces[player] = vectorForce
	finished[player] = false

	if resetRunTimer ~= false then
		runStartedAt[player] = os.clock()
	end

	task.defer(function()
		if not player.Parent or marble.Parent == nil then
			return
		end
		task.wait(0.15)
		if player.Parent and marble.Parent then
			Remotes.AssignMarble:FireClient(player, marble)
		end
	end)
end

local function setupPlayer(player: Player)
	sendCourseInfo(player)

	player.CharacterAdded:Connect(function(character)
		task.defer(function()
			if character.Parent then
				character:Destroy()
			end
		end)
	end)

	lastCheckpoint[player] = 0
	task.defer(function()
		createMarble(player, true)
	end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in Players:GetPlayers() do
	setupPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	local marble = marbles[player]
	if marble then
		marble:Destroy()
	end
	marbles[player] = nil
	driveForces[player] = nil
	finished[player] = nil
	lastCheckpoint[player] = nil
	runStartedAt[player] = nil
	playerMove[player] = nil
	playerJump[player] = nil
end)

Remotes.RequestRespawn.OnServerEvent:Connect(function(player)
	createMarble(player, false)
end)

-- Klient sender: moveX, moveZ (world), jump (bool)
Remotes.PlayerInput.OnServerEvent:Connect(function(player, moveX, moveZ, jump)
	if typeof(moveX) ~= "number" or typeof(moveZ) ~= "number" then
		return
	end
	if not marbles[player] then
		return
	end

	-- Clamp for at undgå exploit / NaN
	if moveX ~= moveX or moveZ ~= moveZ then
		return
	end
	moveX = math.clamp(moveX, -1, 1)
	moveZ = math.clamp(moveZ, -1, 1)

	local move = Vector3.new(moveX, 0, moveZ)
	if move.Magnitude > 1 then
		move = move.Unit
	elseif move.Magnitude < 0.05 then
		move = Vector3.zero
	end
	playerMove[player] = move
	if jump == true then
		playerJump[player] = true
	end
end)

local courseFolder = workspace:WaitForChild("MarbleCourse")
for _, desc in courseFolder:GetDescendants() do
	if desc:IsA("BasePart") and desc:GetAttribute("CheckpointIndex") then
		local cpIndex = desc:GetAttribute("CheckpointIndex") :: number
		desc.Touched:Connect(function(hit)
			if hit:GetAttribute("IsMarble") ~= true then
				return
			end
			local owner: Player? = nil
			for p, marble in marbles do
				if marble == hit then
					owner = p
					break
				end
			end
			if not owner then
				return
			end
			local current = lastCheckpoint[owner] or 0
			if cpIndex <= current then
				return
			end
			lastCheckpoint[owner] = cpIndex
			Remotes.CheckpointUpdated:FireClient(owner, cpIndex, checkpointCount)
		end)
	end
end

goalTrigger.Touched:Connect(function(hit)
	if hit:GetAttribute("IsMarble") ~= true then
		return
	end
	local owner: Player? = nil
	for p, marble in marbles do
		if hit == marble then
			owner = p
			break
		end
	end
	if not owner or finished[owner] then
		return
	end

	finished[owner] = true
	local started = runStartedAt[owner] or os.clock()
	local elapsed = os.clock() - started

	Remotes.RunComplete:FireClient(owner, elapsed)
	Remotes.GoalReached:FireClient(owner)

	task.delay(Config.Game.RestartDelayAfterGoal, function()
		if owner.Parent then
			lastCheckpoint[owner] = 0
			createMarble(owner, true)
		end
	end)
end)

RunService.Heartbeat:Connect(function()
	for player, marble in marbles do
		if not marble.Parent then
			continue
		end

		if marble.Position.Y < Config.RespawnY then
			createMarble(player, false)
			continue
		end

		-- Bevægelse styres lokalt på klienten (smooth arcade).
		-- Hold evt. legacy VectorForce slået fra.
		local forceObj = driveForces[player]
		if forceObj then
			forceObj.Enabled = false
			forceObj.Force = Vector3.zero
		end

		-- Hop kan stadig komme via remote (backup) — primært håndteres på klient
		if playerJump[player] then
			playerJump[player] = false
			if isGrounded(marble) then
				local velocity = marble.AssemblyLinearVelocity
				if velocity.Y <= 8 then
					marble.AssemblyLinearVelocity =
						Vector3.new(velocity.X, Config.Marble.JumpSpeed, velocity.Z)
				end
			end
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="17">
      <Properties>
        <string name="Name">ObstacleEngine</string>
        <string name="Source"><![CDATA[--[[
	ObstacleEngine.luau (server)
	----------------------------
	Bygger og animerer forhindringer:
	- Bevægelige platforme (sinusbølge)
	- Roterende arme ("spinners")
	- Hop-plader og is (via part-attributter)

	Kald ObstacleEngine.start() én gang efter banen er bygget.
]]

local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local ObstacleEngine = {}

type Mover = {
	part: BasePart,
	origin: Vector3,
	axis: "X" | "Z",
	amplitude: number,
	speed: number,
	phase: number,
}

type Spinner = {
	hub: BasePart,
	arm: BasePart,
	armReach: number,
	speed: number,
}

local movers: { Mover } = {}
local spinners: { Spinner } = {}
local started = false

local function makePart(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

-- Platform der glider frem og tilbage — marble skal time sit hop
function ObstacleEngine.addMovingPlatform(
	parent: Instance,
	center: Vector3,
	size: Vector3,
	axis: "X" | "Z",
	amplitude: number,
	speed: number,
	color: Color3?
): Part
	local part = makePart(parent, {
		Name = "MovingPlatform",
		Size = size,
		CFrame = CFrame.new(center),
		Color = color or Color3.fromRGB(200, 120, 60),
		Material = Enum.Material.Metal,
	})
	table.insert(movers, {
		part = part,
		origin = center,
		axis = axis,
		amplitude = amplitude,
		speed = speed,
		phase = math.random() * math.pi * 2,
	})
	return part
end

-- Horisontal arm der drejer — undgå midten!
function ObstacleEngine.addSpinner(parent: Instance, center: Vector3, armLength: number, height: number, speed: number)
	local hub = makePart(parent, {
		Name = "SpinnerHub",
		Size = Vector3.new(3, height, 3),
		CFrame = CFrame.new(center),
		Color = Color3.fromRGB(180, 60, 60),
		Material = Enum.Material.Metal,
	})
	local arm = makePart(parent, {
		Name = "SpinnerArm",
		Size = Vector3.new(armLength * 2, 2.5, 2.5),
		CFrame = CFrame.new(center + Vector3.new(0, height * 0.5 + 1.25, 0)),
		Color = Color3.fromRGB(220, 80, 80),
		Material = Enum.Material.Neon,
	})
	table.insert(spinners, {
		hub = hub,
		arm = arm,
		armReach = armLength,
		speed = speed,
	})
end

function ObstacleEngine.addBouncePad(parent: Instance, cf: CFrame, size: Vector3)
	local pad = makePart(parent, {
		Name = "BouncePad",
		Size = size,
		CFrame = cf,
		Color = Color3.fromRGB(120, 200, 255),
		Material = Enum.Material.Neon,
	})
	pad:SetAttribute("BouncePower", Config.Obstacles.BouncePower)
end

function ObstacleEngine.addIceStrip(parent: Instance, cf: CFrame, size: Vector3)
	local ice = makePart(parent, {
		Name = "IceStrip",
		Size = size,
		CFrame = cf,
		Color = Color3.fromRGB(180, 220, 255),
		Material = Enum.Material.Ice,
	})
	ice.CustomPhysicalProperties = PhysicalProperties.new(0.7, Config.Obstacles.IceFriction, 0.05, 1, 1)
end

function ObstacleEngine.bindBouncePads(folder: Folder)
	for _, desc in folder:GetDescendants() do
		if desc:IsA("BasePart") and desc:GetAttribute("BouncePower") then
			local power = desc:GetAttribute("BouncePower") :: number
			desc.Touched:Connect(function(hit)
				if not hit:IsA("BasePart") or hit:GetAttribute("IsMarble") ~= true then
					return
				end
				local vel = hit.AssemblyLinearVelocity
				if vel.Y > 20 then
					return
				end
				hit.AssemblyLinearVelocity = Vector3.new(vel.X, power, vel.Z)
			end)
		end
	end
end

function ObstacleEngine.start()
	if started then
		return
	end
	started = true

	RunService.Heartbeat:Connect(function(dt)
		local t = os.clock()
		for _, mover in movers do
			local offset = math.sin(t * mover.speed + mover.phase) * mover.amplitude
			local pos = mover.origin
			if mover.axis == "X" then
				pos += Vector3.new(offset, 0, 0)
			else
				pos += Vector3.new(0, 0, offset)
			end
			mover.part.CFrame = CFrame.new(pos)
		end

		for _, spinner in spinners do
			local angle = t * spinner.speed
			local hubPos = spinner.hub.Position + Vector3.new(0, spinner.hub.Size.Y * 0.5 + 1.25, 0)
			spinner.arm.CFrame = CFrame.new(hubPos) * CFrame.Angles(0, angle, 0) * CFrame.new(spinner.armReach, 0, 0)
		end
	end)
end

return ObstacleEngine
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="18">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="19">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">CameraBootstrap</string>
          <string name="Source"><![CDATA[--[[
	CameraBootstrap.client.luau
	---------------------------
	Minimal kamera-script UDEN require/remotes.
	Sikrer at Client-fanen ikke sidder fast på blå himmel, hvis andre scripts fejler
	eller Streaming/Character mangler.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local function followMarble()
	local ball = workspace:FindFirstChild(player.Name .. "_Marble")
	if not (ball and ball:IsA("BasePart")) then
		return
	end

	local cam = workspace.CurrentCamera
	if not cam then
		return
	end

	-- Hvis MarbleControl allerede styrer kameraet, lader det gøre det
	if cam:GetAttribute("MarbleControlActive") == true then
		return
	end

	cam.CameraType = Enum.CameraType.Scriptable
	local pos = ball.Position
	cam.CFrame = CFrame.lookAt(pos + Vector3.new(0, 14, 28), pos + Vector3.new(0, 2, 0))
end

RunService.RenderStepped:Connect(followMarble)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="21">
        <Properties>
          <string name="Name">Hud</string>
          <string name="Source"><![CDATA[--[[
	Hud.client.luau — tid, checkpoints, afstand, debug
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local CourseState = require(Shared:WaitForChild("CourseState"))

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "MarbleHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function makeLabel(props: { [string]: any }): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.TextStrokeTransparency = 0.45
	t.Font = Enum.Font.GothamMedium
	for k, v in props do
		(t :: any)[k] = v
	end
	t.Parent = gui
	return t
end

makeLabel({
	Name = "Title",
	Position = UDim2.new(0, 24, 0, 24),
	Size = UDim2.new(0, 280, 0, 36),
	Font = Enum.Font.GothamBold,
	TextSize = 28,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.new(1, 1, 1),
	Text = "Marble Run",
})

local timerLabel = makeLabel({
	Name = "Timer",
	Position = UDim2.new(0, 24, 0, 64),
	Size = UDim2.new(0, 220, 0, 28),
	TextSize = 22,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(200, 230, 255),
	Text = "Tid: 0:00.0",
})

local checkpointLabel = makeLabel({
	Name = "Checkpoints",
	Position = UDim2.new(0, 24, 0, 96),
	Size = UDim2.new(0, 220, 0, 24),
	TextSize = 18,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(180, 210, 255),
	Text = "Checkpoint: 0/0",
})

local debugLabel = makeLabel({
	Name = "Debug",
	Position = UDim2.new(0, 24, 0, 128),
	Size = UDim2.new(0, 460, 0, 80),
	Font = Enum.Font.Code,
	TextSize = 14,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	TextColor3 = Color3.fromRGB(160, 255, 160),
	Text = "Debug...",
})

local goalLabel = makeLabel({
	Name = "GoalDistance",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -24, 0, 24),
	Size = UDim2.new(0, 260, 0, 40),
	TextSize = 20,
	TextXAlignment = Enum.TextXAlignment.Right,
	TextColor3 = Color3.fromRGB(255, 230, 140),
	Text = "Mål: —",
})

makeLabel({
	Name = "Hint",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -20),
	Size = UDim2.new(0.95, 0, 0, 36),
	TextSize = 16,
	TextColor3 = Color3.fromRGB(240, 245, 255),
	Text = "Klik i Client-vinduet · WASD · pile · Space · Enter · R",
})

local banner = makeLabel({
	Name = "Banner",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.35),
	Size = UDim2.new(0.7, 0, 0, 72),
	Font = Enum.Font.GothamBold,
	TextSize = 48,
	TextColor3 = Color3.fromRGB(255, 220, 80),
	TextTransparency = 1,
	Text = "MÅL NÅET!",
})

local function formatTime(seconds: number): string
	local minutes = math.floor(seconds / 60)
	local secs = seconds - minutes * 60
	return string.format("%d:%04.1f", minutes, secs)
end

local function showBanner(text: string)
	banner.TextTransparency = 0
	banner.Text = text
	task.delay(2.5, function()
		banner.TextTransparency = 1
	end)
end

Remotes.CourseInfo.OnClientEvent:Connect(function(payload)
	CourseState.applyCourseInfo(payload)
	checkpointLabel.Text = string.format("Checkpoint: 0/%d", payload.checkpointCount)
end)

Remotes.CheckpointUpdated.OnClientEvent:Connect(function(index: number, total: number)
	CourseState.setCheckpoint(index)
	checkpointLabel.Text = string.format("Checkpoint: %d/%d", index, total)
	showBanner("Checkpoint " .. index .. "!")
end)

Remotes.RunComplete.OnClientEvent:Connect(function(elapsed: number)
	CourseState.finishRace(elapsed)
	showBanner("MÅL! " .. formatTime(elapsed))
end)

Remotes.GoalReached.OnClientEvent:Connect(function()
	if not CourseState.lastFinishTime then
		showBanner("MÅL NÅET!")
	end
end)

RunService.RenderStepped:Connect(function()
	local elapsed = CourseState.getElapsed()
	if elapsed then
		timerLabel.Text = "Tid: " .. formatTime(elapsed)
	end

	local marbleInst = workspace:FindFirstChild(player.Name .. "_Marble")
	local w = UserInputService:IsKeyDown(Enum.KeyCode.W)
	local a = UserInputService:IsKeyDown(Enum.KeyCode.A)
	local s = UserInputService:IsKeyDown(Enum.KeyCode.S)
	local d = UserInputService:IsKeyDown(Enum.KeyCode.D)

	if marbleInst and marbleInst:IsA("BasePart") then
		local speed = Vector3.new(marbleInst.AssemblyLinearVelocity.X, 0, marbleInst.AssemblyLinearVelocity.Z).Magnitude
		local dist = if CourseState.goalPosition ~= Vector3.zero
			then (CourseState.goalPosition - marbleInst.Position).Magnitude
			else 0
		goalLabel.Text = string.format("Mål: %.0f m", dist)
		debugLabel.Text = string.format(
			"keys W%s A%s S%s D%s\nspeed=%.1f  pos=%.0f,%.0f,%.0f\n(Klik i spilvinduet hvis keys=false)",
			tostring(w),
			tostring(a),
			tostring(s),
			tostring(d),
			speed,
			marbleInst.Position.X,
			marbleInst.Position.Y,
			marbleInst.Position.Z
		)
	else
		debugLabel.Text = "Ingen marble på Client endnu..."
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="22">
        <Properties>
          <string name="Name">MarbleControl</string>
          <string name="Source"><![CDATA[--[[
	MarbleControl.client.luau
	-------------------------
	Smooth arcade-styring:
	- Input glattes (InputSmooth)
	- Hastighed lerper mod ønsket retning (Accel/Steer/Brake)
	- NetworkOwner = spiller → ingen input-lag fra server-roundtrip
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local CourseState = require(Shared:WaitForChild("CourseState"))

local marble: BasePart? = nil
local rawMove = Vector3.zero
local smoothMove = Vector3.zero
local cameraYaw = math.pi
local cameraPitch = 0.35
local jumpRequested = false
local snapCameraToGoal = false
local snapCameraOnce = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function expAlpha(rate: number, dt: number): number
	-- Frame-rate uafhængig lerp-faktor
	return 1 - math.exp(-rate * dt)
end

local function getCamera(): Camera
	local cam = workspace.CurrentCamera
	if not cam then
		cam = Instance.new("Camera")
		cam.Parent = workspace
		workspace.CurrentCamera = cam
	end
	return cam
end

local function cameraOffset(): Vector3
	local distance = Config.Camera.Distance
	local height = Config.Camera.Height
	return Vector3.new(
		math.sin(cameraYaw) * math.cos(cameraPitch) * distance,
		math.sin(cameraPitch) * distance + height * 0.25,
		math.cos(cameraYaw) * math.cos(cameraPitch) * distance
	)
end

local function applyCamera(ball: BasePart, immediate: boolean, dt: number)
	local cam = getCamera()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CameraSubject = ball
	cam:SetAttribute("MarbleControlActive", true)

	local desired = CFrame.lookAt(ball.Position + cameraOffset(), ball.Position + Vector3.new(0, 1.5, 0))
	if immediate then
		cam.CFrame = desired
	else
		cam.CFrame = cam.CFrame:Lerp(desired, expAlpha(9, dt))
	end
end

local function bindMarble(assigned: BasePart?)
	local ball = assigned
	if not (ball and ball:IsA("BasePart")) then
		ball = workspace:FindFirstChild(player.Name .. "_Marble") :: BasePart?
	end
	if not ball then
		return
	end
	marble = ball
	smoothMove = Vector3.zero
	rawMove = Vector3.zero
	cameraYaw = math.pi
	cameraPitch = 0.35
	snapCameraOnce = true
	CourseState.beginRace()
	applyCamera(ball, true, 0)

	-- Sørg for at DriveForce ikke kæmper imod vores velocity-styring
	local drive = ball:FindFirstChild("DriveForce")
	if drive and drive:IsA("VectorForce") then
		drive.Force = Vector3.zero
		drive.Enabled = false
	end
end

local function getCameraFlatLook(): Vector3
	local look = getCamera().CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.05 then
		return Vector3.new(0, 0, -1)
	end
	return flat.Unit
end

local function isGrounded(ball: BasePart): boolean
	rayParams.FilterDescendantsInstances = { ball }
	local radius = ball.Size.Y * 0.5
	local origin = ball.Position
	local direction = Vector3.new(0, -(radius + Config.Marble.GroundCheckPadding), 0)
	if workspace:Raycast(origin, direction, rayParams) then
		return true
	end
	local offsets = {
		Vector3.new(radius * 0.4, 0, 0),
		Vector3.new(-radius * 0.4, 0, 0),
		Vector3.new(0, 0, radius * 0.4),
		Vector3.new(0, 0, -radius * 0.4),
	}
	for _, offset in offsets do
		if workspace:Raycast(origin + offset, direction, rayParams) then
			return true
		end
	end
	return false
end

local function updateRawMoveFromKeys()
	local x, z = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		z -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		z += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		x -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		x += 1
	end

	local look = getCameraFlatLook()
	local right = Vector3.new(-look.Z, 0, look.X)
	local dir = (look * -z) + (right * x)
	if dir.Magnitude > 1 then
		dir = dir.Unit
	elseif dir.Magnitude > 0.01 then
		dir = dir.Unit * dir.Magnitude
	else
		dir = Vector3.zero
	end
	rawMove = dir
end

local function updateCameraFromKeys(dt: number)
	local yawInput = 0
	local pitchInput = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		yawInput += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		yawInput -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Up) then
		pitchInput += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Down) then
		pitchInput -= 1
	end
	if yawInput ~= 0 then
		cameraYaw += yawInput * Config.Camera.TurnSpeed * dt
	end
	if pitchInput ~= 0 then
		cameraPitch = math.clamp(cameraPitch + pitchInput * Config.Camera.PitchSpeed * dt, 0.15, 1.2)
	end
end

local function updateCameraSnapToGoal(dt: number)
	if not snapCameraToGoal or not marble then
		return
	end
	local delta = CourseState.goalPosition - marble.Position
	local flat = Vector3.new(delta.X, 0, delta.Z)
	if flat.Magnitude < 6 then
		snapCameraToGoal = false
		return
	end
	local targetYaw = math.atan2(-flat.X, -flat.Z)
	local diff = (targetYaw - cameraYaw + math.pi) % (2 * math.pi) - math.pi
	if math.abs(diff) < 0.04 then
		cameraYaw = targetYaw
		snapCameraToGoal = false
	else
		cameraYaw += math.clamp(diff, -Config.Camera.GoalSnapSpeed * dt, Config.Camera.GoalSnapSpeed * dt)
	end
end

--[[
	Kerne: smooth velocity-styring
	desiredVel = smoothMove * MaxSpeed
	Nuværende horisontal hastighed lerper mod desired (accel/steer),
	eller mod 0 når der ikke er input (brake).
]]
local function applySmoothDrive(ball: BasePart, dt: number)
	smoothMove = smoothMove:Lerp(rawMove, expAlpha(Config.Marble.InputSmooth, dt))
	if smoothMove.Magnitude < 0.02 then
		smoothMove = Vector3.zero
	end

	local vel = ball.AssemblyLinearVelocity
	local horizontal = Vector3.new(vel.X, 0, vel.Z)
	local newHorizontal: Vector3

	if smoothMove.Magnitude > 0.02 then
		local desired = smoothMove.Unit * (Config.Marble.MaxSpeed * math.clamp(smoothMove.Magnitude, 0, 1))
		-- Bland accel + steer: hurtigere drejning når vi allerede kører
		local rate = Config.Marble.AccelRate
		if horizontal.Magnitude > 4 then
			rate = math.max(rate, Config.Marble.SteerRate)
		end
		newHorizontal = horizontal:Lerp(desired, expAlpha(rate, dt))
	else
		newHorizontal = horizontal:Lerp(Vector3.zero, expAlpha(Config.Marble.BrakeRate, dt))
		if newHorizontal.Magnitude < 0.35 then
			newHorizontal = Vector3.zero
		end
	end

	ball.AssemblyLinearVelocity = Vector3.new(newHorizontal.X, vel.Y, newHorizontal.Z)

	-- Blød rotation (ser mere “rullende” ud)
	local angular = ball.AssemblyAngularVelocity
	local targetSpin = Vector3.new(-newHorizontal.Z, 0, newHorizontal.X) * 0.35
	ball.AssemblyAngularVelocity = angular:Lerp(targetSpin, expAlpha(6, dt))
end

local function tryJump(ball: BasePart)
	if not isGrounded(ball) then
		return
	end
	local vel = ball.AssemblyLinearVelocity
	if vel.Y > 6 then
		return
	end
	ball.AssemblyLinearVelocity = Vector3.new(vel.X, Config.Marble.JumpSpeed, vel.Z)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.R then
		Remotes.RequestRespawn:FireServer()
	elseif input.KeyCode == Enum.KeyCode.Return then
		snapCameraToGoal = true
	elseif input.KeyCode == Enum.KeyCode.Space then
		jumpRequested = true
	end
end)

Remotes.CourseInfo.OnClientEvent:Connect(function(payload)
	CourseState.applyCourseInfo(payload)
end)

Remotes.AssignMarble.OnClientEvent:Connect(function(assigned)
	bindMarble(assigned)
end)

task.defer(function()
	local found = workspace:WaitForChild(player.Name .. "_Marble", 10)
	if found and found:IsA("BasePart") then
		bindMarble(found)
	end
end)

RunService.RenderStepped:Connect(function(dt)
	-- Clamp dt så et hitch ikke skyder marble afsted
	dt = math.clamp(dt, 0, 1 / 20)

	updateRawMoveFromKeys()
	updateCameraFromKeys(dt)
	updateCameraSnapToGoal(dt)

	local ball = marble
	if not ball or not ball.Parent then
		return
	end

	if jumpRequested then
		jumpRequested = false
		tryJump(ball)
	end

	applySmoothDrive(ball, dt)

	local immediate = snapCameraOnce
	snapCameraOnce = false
	applyCamera(ball, immediate, dt)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="23">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
    <Item class="Part" referent="24">
      <Properties>
        <string name="Name">Baseplate</string>
        <bool name="Anchored">true</bool>
        <bool name="CanCollide">false</bool>
        <Vector3 name="Position">
          <X>0</X>
          <Y>-50</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>1</X>
          <Y>1</Y>
          <Z>1</Z>
        </Vector3>
        <float name="Transparency">1</float>
      </Properties>
    </Item>
