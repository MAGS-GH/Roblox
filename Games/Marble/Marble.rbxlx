      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config.luau — tuning for smooth marble-kørsel
]]

local Config = {
	Marble = {
		Diameter = 4,
		Density = 0.85,
		Friction = 0.55,
		Elasticity = 0.05,
		JumpSpeed = 48,
		GroundCheckPadding = 0.4,

		-- Hastighed & glathed (arcade-velocity, ikke rå force)
		MaxSpeed = 46,
		-- Hvor hurtigt vi accelererer op mod MaxSpeed (højere = snappier)
		AccelRate = 8,
		-- Hvor hurtigt vi bremser uden input
		BrakeRate = 6,
		-- Hvor hurtigt retning ændres mens vi kører (drejning)
		SteerRate = 10,
		-- Input softens (tastetryk glattes før de bruges)
		InputSmooth = 14,
	},

	Camera = {
		Distance = 24,
		Height = 11,
		Smoothness = 0.14,
		TurnSpeed = 2.4,
		PitchSpeed = 1.7,
		GoalSnapSpeed = 6,
	},

	RespawnY = -80,

	Game = {
		RestartDelayAfterGoal = 4,
	},

	Obstacles = {
		BouncePower = 70,
		IceFriction = 0.08,
	},
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CourseState</string>
          <string name="Source"><![CDATA[--[[
	CourseState.luau (klient)
	-------------------------
	Lille state bag som HUD og kontrol-script deler.
]]

export type CourseInfoPayload = {
	goalPosition: Vector3,
	checkpointCount: number,
}

local CourseState = {
	goalPosition = Vector3.zero,
	checkpointCount = 0,
	currentCheckpoint = 0,
	raceStartTime = nil :: number?,
	lastFinishTime = nil :: number?,
}

function CourseState.applyCourseInfo(payload: CourseInfoPayload)
	CourseState.goalPosition = payload.goalPosition
	CourseState.checkpointCount = payload.checkpointCount
	CourseState.currentCheckpoint = 0
end

function CourseState.beginRace()
	CourseState.raceStartTime = os.clock()
	CourseState.lastFinishTime = nil
	CourseState.currentCheckpoint = 0
end

function CourseState.setCheckpoint(index: number)
	CourseState.currentCheckpoint = index
end

function CourseState.finishRace(elapsed: number)
	CourseState.lastFinishTime = elapsed
	CourseState.raceStartTime = nil
end

function CourseState.getElapsed(): number?
	if not CourseState.raceStartTime then
		return nil
	end
	return os.clock() - CourseState.raceStartTime
end

return CourseState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes.luau — referencer til RemoteEvents i ReplicatedStorage/MarbleRemotes
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:WaitForChild("MarbleRemotes")

return {
	Folder = folder,
	AssignMarble = folder:WaitForChild("AssignMarble") :: RemoteEvent,
	RequestRespawn = folder:WaitForChild("RequestRespawn") :: RemoteEvent,
	GoalReached = folder:WaitForChild("GoalReached") :: RemoteEvent,
	CourseInfo = folder:WaitForChild("CourseInfo") :: RemoteEvent,
	CheckpointUpdated = folder:WaitForChild("CheckpointUpdated") :: RemoteEvent,
	RunComplete = folder:WaitForChild("RunComplete") :: RemoteEvent,
	PlayerInput = folder:WaitForChild("PlayerInput") :: RemoteEvent,
}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="15">
      <Properties>
        <string name="Name">CourseBuilder</string>
        <string name="Source"><![CDATA[--[[
	CourseBuilder.luau
	------------------
	Ren, sammenhængende bane (ingen overlap-rod).
	Højder = gulv-TOP. Segmenter overlapper lidt i enderne.
	Mange stabile bevægelige forhindringer via ObstacleEngine.
]]

local ObstacleEngine = require(script.Parent:WaitForChild("ObstacleEngine"))

export type CheckpointRecord = {
	index: number,
	position: Vector3,
}

local CourseBuilder = {}

local FLOOR = 2
local WALL_T = 1.5
local WALL_H = 6
local TRACK = 20
local OVERLAP = 2

local GRASS = Color3.fromRGB(92, 148, 98)
local GRASS_DARK = Color3.fromRGB(78, 128, 88)
local WOOD = Color3.fromRGB(158, 118, 72)
local PLANKS = Color3.fromRGB(170, 135, 85)
local STONE = Color3.fromRGB(112, 118, 128)
local CONCRETE = Color3.fromRGB(130, 136, 142)
local ACCENT = Color3.fromRGB(70, 88, 110)
local GOAL_COLOR = Color3.fromRGB(236, 196, 64)
local START_COLOR = Color3.fromRGB(72, 168, 118)

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = props.Name or "Part"
	p.Anchored = true
	p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Color = props.Color or GRASS
	p.Material = props.Material or Enum.Material.Grass
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Transparency = props.Transparency or 0
	p.Parent = parent
	return p
end

local function wall(parent: Instance, size: Vector3, cf: CFrame): Part
	return part(parent, {
		Name = "Wall",
		Size = size,
		CFrame = cf,
		Color = ACCENT,
		Material = Enum.Material.Slate,
	})
end

local function label(parent: BasePart, text: string, color: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 16
	gui.Parent = parent
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.TextColor3 = color
	t.TextStrokeTransparency = 0.5
	t.Text = text
	t.Parent = gui
end

local function floorBox(parent, name, cx, cz, sx, sz, topY, color, material)
	return part(parent, {
		Name = name,
		Size = Vector3.new(sx, FLOOR, sz),
		CFrame = CFrame.new(cx, topY - FLOOR / 2, cz),
		Color = color or GRASS,
		Material = material or Enum.Material.Grass,
	})
end

local function rampX(parent, name, x0, x1, z, width, y0, y1, color, material)
	local dx, dy = x1 - x0, y1 - y0
	local dist = math.sqrt(dx * dx + dy * dy)
	local angle = math.atan2(dy, dx)
	local mid = Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, z)
	local cf = CFrame.new(mid) * CFrame.Angles(0, 0, angle) * CFrame.new(0, -FLOOR / 2, 0)
	return part(parent, {
		Name = name,
		Size = Vector3.new(dist, FLOOR, width),
		CFrame = cf,
		Color = color or PLANKS,
		Material = material or Enum.Material.WoodPlanks,
	})
end

local function wallsAlongZ(parent, cx, zMid, length, topY, trackWidth)
	local wallY = topY + WALL_H / 2
	wall(parent, Vector3.new(WALL_T, WALL_H, length), CFrame.new(cx - trackWidth / 2 - WALL_T / 2, wallY, zMid))
	wall(parent, Vector3.new(WALL_T, WALL_H, length), CFrame.new(cx + trackWidth / 2 + WALL_T / 2, wallY, zMid))
end

local function wallsAlongX(parent, cz, xMid, length, topY, trackWidth)
	local wallY = topY + WALL_H / 2
	wall(parent, Vector3.new(length, WALL_H, WALL_T), CFrame.new(xMid, wallY, cz - trackWidth / 2 - WALL_T / 2))
	wall(parent, Vector3.new(length, WALL_H, WALL_T), CFrame.new(xMid, wallY, cz + trackWidth / 2 + WALL_T / 2))
end

local function rampWallsX(parent, x0, x1, z, trackWidth, y0, y1)
	local dx, dy = x1 - x0, y1 - y0
	local dist = math.sqrt(dx * dx + dy * dy)
	local angle = math.atan2(dy, dx)
	local mid = Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, z)
	local base = CFrame.new(mid) * CFrame.Angles(0, 0, angle)
	local side = trackWidth / 2 + WALL_T / 2
	wall(parent, Vector3.new(dist, WALL_H, WALL_T), base * CFrame.new(0, WALL_H / 2, -side))
	wall(parent, Vector3.new(dist, WALL_H, WALL_T), base * CFrame.new(0, WALL_H / 2, side))
end

local function plazaWalls(parent, cx, cz, sx, sz, topY, open)
	local wallY = topY + WALL_H / 2
	local hx, hz = sx / 2, sz / 2
	local gap = TRACK / 2

	local function edge(full: boolean, isX: boolean, sign: number, midShift: number)
		if full then
			if isX then
				wall(parent, Vector3.new(sx + WALL_T, WALL_H, WALL_T), CFrame.new(cx, wallY, cz + sign * (hz + WALL_T / 2)))
			else
				wall(parent, Vector3.new(WALL_T, WALL_H, sz + WALL_T), CFrame.new(cx + sign * (hx + WALL_T / 2), wallY, cz))
			end
		else
			local side = (if isX then hx else hz) - gap
			if side > 1 then
				if isX then
					wall(parent, Vector3.new(side, WALL_H, WALL_T), CFrame.new(cx - gap - side / 2, wallY, cz + sign * (hz + WALL_T / 2)))
					wall(parent, Vector3.new(side, WALL_H, WALL_T), CFrame.new(cx + gap + side / 2, wallY, cz + sign * (hz + WALL_T / 2)))
				else
					wall(parent, Vector3.new(WALL_T, WALL_H, side), CFrame.new(cx + sign * (hx + WALL_T / 2), wallY, cz - gap - side / 2))
					wall(parent, Vector3.new(WALL_T, WALL_H, side), CFrame.new(cx + sign * (hx + WALL_T / 2), wallY, cz + gap + side / 2))
				end
			end
		end
	end

	edge(not open.north, true, -1, 0)
	edge(not open.south, true, 1, 0)
	edge(not open.west, false, -1, 0)
	edge(not open.east, false, 1, 0)
end

local function addCheckpoint(parent, index, cx, cz, topY, checkpoints)
	local pad = floorBox(parent, "Checkpoint_" .. index, cx, cz, 16, 16, topY, Color3.fromRGB(80, 160, 220), Enum.Material.Neon)
	label(pad, "CP " .. index, Color3.fromRGB(255, 255, 255))
	local trigger = part(parent, {
		Name = "CheckpointTrigger",
		Size = Vector3.new(14, 8, 14),
		CFrame = CFrame.new(cx, topY + 4, cz),
		Transparency = 1,
		CanCollide = false,
	})
	trigger:SetAttribute("CheckpointIndex", index)
	table.insert(checkpoints, { index = index, position = Vector3.new(cx, topY + 5, cz) })
end

function CourseBuilder.build(): (Folder, Attachment, BasePart, { CheckpointRecord })
	local folder = Instance.new("Folder")
	folder.Name = "MarbleCourse"
	folder.Parent = workspace
	local checkpoints: { CheckpointRecord } = {}

	local H0 = 4

	----------------------------------------------------------------
	-- 1 START
	----------------------------------------------------------------
	local start = floorBox(folder, "StartPad", 0, 0, 44, 44, H0, START_COLOR, Enum.Material.Grass)
	label(start, "START", Color3.new(1, 1, 1))
	plazaWalls(folder, 0, 0, 44, 44, H0, { south = true })
	local spawnAttachment = Instance.new("Attachment")
	spawnAttachment.Name = "Spawn"
	spawnAttachment.Position = Vector3.new(0, 7, 0)
	spawnAttachment.Parent = start

	----------------------------------------------------------------
	-- 2 INTRO (+Z) — rolige platforme der glider sideværts
	----------------------------------------------------------------
	local z = 22
	local introLen = 70
	floorBox(folder, "Intro", 0, z + introLen / 2, TRACK, introLen, H0, GRASS)
	wallsAlongZ(folder, 0, z + introLen / 2, introLen, H0, TRACK)

	for i = 1, 3 do
		local pz = z + 18 + (i - 1) * 18
		-- Intro: safe orange platforms (ikke lethal)
		ObstacleEngine.addSlidingPlatform(
			folder,
			CFrame.new(0, H0 + 1.2, pz),
			Vector3.new(7, 1.5, 7),
			Vector3.xAxis,
			7,
			1.5 + i * 0.2,
			i * 1.1,
			Color3.fromRGB(230, 140, 60),
			false
		)
	end
	-- Ét kill-blade midt i intro
	ObstacleEngine.addSpinner(folder, Vector3.new(0, H0 + 3.5, z + 40), 9, 5, 2.4, 0.2, true)
	z += introLen - OVERLAP

	addCheckpoint(folder, 1, 0, z + 10, H0, checkpoints)
	floorBox(folder, "CP1Plaza", 0, z + 12, 36, 28, H0, GRASS_DARK)
	plazaWalls(folder, 0, z + 12, 36, 28, H0, { north = true, south = true })
	z += 26

	----------------------------------------------------------------
	-- 3 VOID + GLIDENDE PLATFORME (rigtigt hul — to canyon-stykker)
	----------------------------------------------------------------
	local beforeLen = 40
	floorBox(folder, "CanyonA", 0, z + beforeLen / 2, TRACK, beforeLen, H0, STONE, Enum.Material.Slate)
	wallsAlongZ(folder, 0, z + beforeLen / 2, beforeLen, H0, TRACK)
	z += beforeLen

	local gapLen = 56
	local gapMid = z + gapLen / 2
	part(folder, {
		Name = "VoidHint",
		Size = Vector3.new(TRACK + 4, 1, gapLen),
		CFrame = CFrame.new(0, H0 - 8, gapMid),
		Color = Color3.fromRGB(25, 28, 35),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Transparency = 0.35,
	})
	wallsAlongZ(folder, 0, gapMid, gapLen, H0, TRACK)

	-- Kun 3 stepping stones (sværere timing) + kill-spinner
	for i = 1, 3 do
		local t = (i - 0.5) / 3
		local pz = z + t * gapLen
		local axis = if i % 2 == 1 then Vector3.xAxis else Vector3.zAxis
		ObstacleEngine.addSlidingPlatform(
			folder,
			CFrame.new(0, H0, pz),
			Vector3.new(9, 2, 9),
			axis,
			6.5,
			1.4 + i * 0.25,
			i * 0.9,
			Color3.fromRGB(255, 150, 70),
			false
		)
	end
	ObstacleEngine.addSpinner(folder, Vector3.new(0, H0 + 3.5, gapMid), 12, 5, 2.2, 0.3, true)
	ObstacleEngine.addSwingingHammer(folder, Vector3.new(0, H0 + 15, gapMid + 10), 13, 1.8, 60, 0.5, true)
	z += gapLen

	local afterLen = 35
	floorBox(folder, "CanyonB", 0, z + afterLen / 2, TRACK, afterLen, H0, STONE, Enum.Material.Slate)
	wallsAlongZ(folder, 0, z + afterLen / 2, afterLen, H0, TRACK)
	z += afterLen - OVERLAP

	----------------------------------------------------------------
	-- 4 TURN EAST (+X)
	----------------------------------------------------------------
	floorBox(folder, "Turn1", 16, z + 18, 52, 40, H0, GRASS_DARK)
	plazaWalls(folder, 16, z + 18, 52, 40, H0, { north = true, east = true })
	local turnZ = z + 18
	local x = 16 + 26 - OVERLAP

	----------------------------------------------------------------
	-- 5 HAMMER ALLEY (+X)
	----------------------------------------------------------------
	local alleyLen = 140
	floorBox(folder, "HammerAlley", x + alleyLen / 2, turnZ, alleyLen, TRACK, H0, CONCRETE, Enum.Material.Concrete)
	wallsAlongX(folder, turnZ, x + alleyLen / 2, alleyLen, H0, TRACK)

	-- 7 lethale hamre
	for i = 1, 7 do
		local px = x + 14 + (i - 1) * 17
		ObstacleEngine.addSwingingHammer(
			folder,
			Vector3.new(px, H0 + 14, turnZ),
			12,
			1.7 + i * 0.1,
			62,
			i * 0.55,
			true
		)
	end
	-- Glidende KILL-crushers på gulvet
	for i = 1, 4 do
		local px = x + 22 + (i - 1) * 28
		ObstacleEngine.addSlidingPlatform(
			folder,
			CFrame.new(px, H0 + 2.2, turnZ),
			Vector3.new(5, 4, 5),
			Vector3.zAxis,
			6,
			2.0,
			i * 0.8,
			nil,
			true
		)
	end
	x += alleyLen - OVERLAP

	addCheckpoint(folder, 2, x + 14, turnZ, H0, checkpoints)
	floorBox(folder, "CP2Plaza", x + 16, turnZ, 36, 36, H0, STONE, Enum.Material.Concrete)
	plazaWalls(folder, x + 16, turnZ, 36, 36, H0, { west = true, east = true })
	x += 34

	----------------------------------------------------------------
	-- 6 ELEVATOR TOWER (+X climb via rising pads + ramp)
	----------------------------------------------------------------
	local H1 = 28
	-- Solid climb ramp (stable)
	local climbLen = 70
	rampX(folder, "ClimbRamp", x, x + climbLen, turnZ, TRACK, H0, H1, PLANKS)
	rampWallsX(folder, x, x + climbLen, turnZ, TRACK, H0, H1)

	-- Side elevators as optional hard path / hazard near mid
	for i = 1, 3 do
		local px = x + 18 + (i - 1) * 16
		ObstacleEngine.addElevator(
			folder,
			CFrame.new(px, H0 + 4 + (i - 1) * 3, turnZ + TRACK / 2 + 6),
			Vector3.new(8, 1.5, 8),
			5,
			1.1,
			i * 0.9
		)
	end
	x += climbLen - OVERLAP

	floorBox(folder, "SkyPlaza", x + 22, turnZ, 48, 48, H1, CONCRETE, Enum.Material.Concrete)
	plazaWalls(folder, x + 22, turnZ, 48, 48, H1, { west = true, south = true })
	addCheckpoint(folder, 3, x + 22, turnZ, H1, checkpoints)
	local skyCX, skyCZ = x + 22, turnZ
	x = skyCX -- continue from plaza center for naming; actual leave south

	----------------------------------------------------------------
	-- 7 HIGH ROAD (+Z) with moving side-crushers + spinner
	----------------------------------------------------------------
	local highZ0 = skyCZ + 24 - OVERLAP
	local highLen = 90
	floorBox(folder, "HighRoad", skyCX, highZ0 + highLen / 2, TRACK, highLen, H1, CONCRETE, Enum.Material.Concrete)
	wallsAlongZ(folder, skyCX, highZ0 + highLen / 2, highLen, H1, TRACK)

	for i = 1, 5 do
		local pz = highZ0 + 12 + (i - 1) * 15
		-- Side-crushers = KILL
		ObstacleEngine.addSlidingPlatform(
			folder,
			CFrame.new(skyCX, H1 + 2.5, pz),
			Vector3.new(5, 5, 3.5),
			Vector3.xAxis,
			8,
			2.2,
			i * 1.1,
			nil,
			true
		)
	end
	ObstacleEngine.addSpinner(folder, Vector3.new(skyCX, H1 + 4, highZ0 + highLen / 2), 14, 6, 2.6, 0.5, true)
	ObstacleEngine.addSpinner(folder, Vector3.new(skyCX, H1 + 4, highZ0 + highLen * 0.75), 10, 5, 2.8, 1.2, true)
	ObstacleEngine.addIceStrip(
		folder,
		CFrame.new(skyCX, H1 - 1, highZ0 + highLen * 0.65),
		Vector3.new(TRACK - 4, FLOOR, 36)
	)

	local highZ1 = highZ0 + highLen - OVERLAP

	----------------------------------------------------------------
	-- 8 NARROW BRIDGE with swinging hammers
	----------------------------------------------------------------
	floorBox(folder, "BridgePlaza", skyCX, highZ1 + 16, 36, 36, H1, WOOD, Enum.Material.Wood)
	plazaWalls(folder, skyCX, highZ1 + 16, 36, 36, H1, { north = true, south = true })

	local bridgeZ0 = highZ1 + 16 + 18 - OVERLAP
	local bridgeW = 9
	local bridgeLen = 110
	floorBox(folder, "Bridge", skyCX, bridgeZ0 + bridgeLen / 2, bridgeW, bridgeLen, H1, WOOD, Enum.Material.Wood)
	for i = 1, 6 do
		local pz = bridgeZ0 + 14 + (i - 1) * 16
		ObstacleEngine.addSwingingHammer(
			folder,
			Vector3.new(skyCX, H1 + 13, pz),
			11,
			1.8 + i * 0.12,
			58,
			i * 0.7,
			true
		)
	end
	local bridgeZ1 = bridgeZ0 + bridgeLen - OVERLAP

	----------------------------------------------------------------
	-- 9 LANDING + DESCENT
	----------------------------------------------------------------
	floorBox(folder, "Landing", skyCX, bridgeZ1 + 18, 40, 40, H1, CONCRETE, Enum.Material.Concrete)
	plazaWalls(folder, skyCX, bridgeZ1 + 18, 40, 40, H1, { north = true, east = true })
	addCheckpoint(folder, 4, skyCX, bridgeZ1 + 18, H1, checkpoints)

	local H2 = 10
	local landCZ = bridgeZ1 + 18
	local descX0 = skyCX + 20 - OVERLAP
	local descX1 = descX0 + 50
	rampX(folder, "Descend", descX0, descX1, landCZ, TRACK, H1, H2, PLANKS)
	rampWallsX(folder, descX0, descX1, landCZ, TRACK, H1, H2)

	----------------------------------------------------------------
	-- 10 FINAL GAUNTLET (+X) — elevators + spinners + bounce
	----------------------------------------------------------------
	local finX0 = descX1 - OVERLAP
	local finLen = 130
	floorBox(folder, "Final", finX0 + finLen / 2, landCZ, finLen, TRACK, H2, GRASS)
	wallsAlongX(folder, landCZ, finX0 + finLen / 2, finLen, H2, TRACK)

	for i = 1, 5 do
		local px = finX0 + 16 + (i - 1) * 20
		ObstacleEngine.addElevator(
			folder,
			CFrame.new(px, H2 + 1, landCZ),
			Vector3.new(8, 1.5, 8),
			4.5,
			1.6,
			i * 0.5,
			Color3.fromRGB(90, 170, 220),
			false
		)
		ObstacleEngine.addSpinner(folder, Vector3.new(px + 9, H2 + 4, landCZ), 10, 5, 2.8, i, true)
	end
	-- Lethal floor crushers
	for i = 1, 3 do
		local px = finX0 + 30 + (i - 1) * 32
		ObstacleEngine.addSlidingPlatform(
			folder,
			CFrame.new(px, H2 + 2, landCZ),
			Vector3.new(4, 4, 4),
			Vector3.zAxis,
			7,
			2.4,
			i,
			nil,
			true
		)
	end
	ObstacleEngine.addBouncePad(folder, CFrame.new(finX0 + 55, H2 + 0.8, landCZ), Vector3.new(9, 1.2, 9))
	ObstacleEngine.addIceStrip(
		folder,
		CFrame.new(finX0 + 95, H2 - 1, landCZ),
		Vector3.new(45, FLOOR, TRACK - 4)
	)

	local finX1 = finX0 + finLen - OVERLAP
	floorBox(folder, "PreGoal", finX1 + 18, landCZ, 40, 40, H2, GRASS_DARK)
	plazaWalls(folder, finX1 + 18, landCZ, 40, 40, H2, { west = true, south = true })
	addCheckpoint(folder, 5, finX1 + 18, landCZ, H2, checkpoints)

	local approachZ0 = landCZ + 20 - OVERLAP
	local approachLen = 55
	floorBox(folder, "GoalApproach", finX1 + 18, approachZ0 + approachLen / 2, TRACK, approachLen, H2, GRASS)
	wallsAlongZ(folder, finX1 + 18, approachZ0 + approachLen / 2, approachLen, H2, TRACK)

	-- Sidste kill-spinner før mål
	ObstacleEngine.addSpinner(folder, Vector3.new(finX1 + 18, H2 + 4, approachZ0 + 28), 11, 5, 2.5, 0.4, true)
	ObstacleEngine.addSlidingPlatform(
		folder,
		CFrame.new(finX1 + 18, H2 + 1, approachZ0 + 40),
		Vector3.new(7, 1.5, 7),
		Vector3.xAxis,
		6.5,
		2.0,
		0.2,
		Color3.fromRGB(230, 140, 60),
		false
	)

	----------------------------------------------------------------
	-- 11 GOAL
	----------------------------------------------------------------
	local goalCX = finX1 + 18
	local goalCZ = approachZ0 + approachLen + 18 - OVERLAP
	local goalPad = floorBox(folder, "GoalPad", goalCX, goalCZ, 40, 40, H2, GOAL_COLOR, Enum.Material.Neon)
	label(goalPad, "MÅL!", Color3.fromRGB(40, 28, 8))
	plazaWalls(folder, goalCX, goalCZ, 40, 40, H2, { north = true })

	local goal = part(folder, {
		Name = "GoalTrigger",
		Size = Vector3.new(26, 12, 26),
		CFrame = CFrame.new(goalCX, H2 + 6, goalCZ),
		Transparency = 1,
		CanCollide = false,
	})
	goal:SetAttribute("IsGoal", true)

	local light = Instance.new("PointLight")
	light.Brightness = 2.5
	light.Range = 45
	light.Color = Color3.fromRGB(255, 220, 120)
	light.Parent = goalPad

	ObstacleEngine.bindBouncePads(folder)
	ObstacleEngine.start()

	return folder, spawnAttachment, goal, checkpoints
end

return CourseBuilder
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">Game</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Game.server.luau (server)
	-------------------------
	Spillogik + SERVER-STYRET bevægelse.

	Hvorfor server-styring?
	- Client ApplyImpulse fejler ofte i Studio uden stabil network-owner.
	- Klienten sender kun input (retning + hop); server sætter VectorForce.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local ObstacleEngine = require(script.Parent:WaitForChild("ObstacleEngine"))
local CourseBuilder = require(script.Parent:WaitForChild("CourseBuilder"))

Players.CharacterAutoLoads = false

pcall(function()
	workspace.StreamingEnabled = false
end)

local courseFolder, spawnAttachment, goalTrigger, checkpoints = CourseBuilder.build()
local goalPosition = goalTrigger.Position
local checkpointCount = #checkpoints

local marbles: { [Player]: BasePart } = {}
local driveForces: { [Player]: VectorForce } = {}
local finished: { [Player]: boolean } = {}
local lastCheckpoint: { [Player]: number } = {}
local runStartedAt: { [Player]: number } = {}
local killCooldown: { [Player]: number } = {}

-- Seneste input fra klient (world XZ, already normalized-ish)
local playerMove: { [Player]: Vector3 } = {}
local playerJump: { [Player]: boolean } = {}

local groundRay = RaycastParams.new()
groundRay.FilterType = Enum.RaycastFilterType.Exclude

local function getSpawnPosition(player: Player): Vector3
	local cpIndex = lastCheckpoint[player] or 0
	if cpIndex > 0 then
		for _, record in checkpoints do
			if record.index == cpIndex then
				return record.position
			end
		end
	end
	return spawnAttachment.WorldPosition
end

local function sendCourseInfo(player: Player)
	Remotes.CourseInfo:FireClient(player, {
		goalPosition = goalPosition,
		checkpointCount = checkpointCount,
	})
end

local function isGrounded(ball: BasePart): boolean
	groundRay.FilterDescendantsInstances = { ball }
	local radius = ball.Size.Y * 0.5
	local origin = ball.Position
	local direction = Vector3.new(0, -(radius + Config.Marble.GroundCheckPadding), 0)
	if workspace:Raycast(origin, direction, groundRay) then
		return true
	end
	local offsets = {
		Vector3.new(radius * 0.35, 0, 0),
		Vector3.new(-radius * 0.35, 0, 0),
		Vector3.new(0, 0, radius * 0.35),
		Vector3.new(0, 0, -radius * 0.35),
	}
	for _, offset in offsets do
		if workspace:Raycast(origin + offset, direction, groundRay) then
			return true
		end
	end
	return false
end

local function createMarble(player: Player, resetRunTimer: boolean?)
	local existing = marbles[player]
	if existing then
		existing:Destroy()
	end
	marbles[player] = nil
	driveForces[player] = nil
	playerMove[player] = Vector3.zero
	playerJump[player] = false

	local diameter = Config.Marble.Diameter
	local marble = Instance.new("Part")
	marble.Name = player.Name .. "_Marble"
	marble.Shape = Enum.PartType.Ball
	marble.Size = Vector3.new(diameter, diameter, diameter)
	marble.Color = Color3.fromHSV((player.UserId % 1000) / 1000, 0.65, 0.95)
	marble.Material = Enum.Material.SmoothPlastic
	marble.TopSurface = Enum.SurfaceType.Smooth
	marble.BottomSurface = Enum.SurfaceType.Smooth
	marble.CanCollide = true
	marble.Anchored = false
	marble:SetAttribute("IsMarble", true)
	marble.CustomPhysicalProperties = PhysicalProperties.new(
		Config.Marble.Density,
		Config.Marble.Friction,
		Config.Marble.Elasticity,
		1,
		1
	)

	local spawnPos = getSpawnPosition(player)
	local safeSpawn = spawnPos + Vector3.new(0, Config.Marble.Diameter * 0.5 + 2, 0)
	marble.CFrame = CFrame.new(safeSpawn)
	marble.AssemblyLinearVelocity = Vector3.zero
	marble.AssemblyAngularVelocity = Vector3.zero
	marble.Parent = workspace

	-- Drive force (server opdaterer Force hvert Heartbeat)
	local attachment = Instance.new("Attachment")
	attachment.Name = "DriveAttachment"
	attachment.Parent = marble

	local vectorForce = Instance.new("VectorForce")
	vectorForce.Name = "DriveForce"
	vectorForce.Attachment0 = attachment
	vectorForce.RelativeTo = Enum.ActuatorRelativeTo.World
	vectorForce.ApplyAtCenterOfMass = true
	vectorForce.Force = Vector3.zero
	vectorForce.Parent = marble

	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.7
	highlight.OutlineTransparency = 0
	highlight.FillColor = marble.Color
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = marble

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(120, 28)
	billboard.StudsOffset = Vector3.new(0, diameter * 0.7, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = marble

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(1, 1)
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.Text = player.DisplayName
	nameLabel.Parent = billboard

	-- Klienten ejer fysikken → smooth lokal styring uden netværks-lag
	pcall(function()
		marble:SetNetworkOwner(player)
	end)

	-- DriveForce bruges ikke længere (klient kører velocity-arcade)
	vectorForce.Enabled = false
	vectorForce.Force = Vector3.zero


	marbles[player] = marble
	driveForces[player] = vectorForce
	finished[player] = false

	if resetRunTimer ~= false then
		runStartedAt[player] = os.clock()
	end

	task.defer(function()
		if not player.Parent or marble.Parent == nil then
			return
		end
		task.wait(0.15)
		if player.Parent and marble.Parent then
			Remotes.AssignMarble:FireClient(player, marble)
		end
	end)
end

local function setupPlayer(player: Player)
	sendCourseInfo(player)

	player.CharacterAdded:Connect(function(character)
		task.defer(function()
			if character.Parent then
				character:Destroy()
			end
		end)
	end)

	lastCheckpoint[player] = 0
	task.defer(function()
		createMarble(player, true)
	end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in Players:GetPlayers() do
	setupPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	local marble = marbles[player]
	if marble then
		marble:Destroy()
	end
	marbles[player] = nil
	driveForces[player] = nil
	finished[player] = nil
	lastCheckpoint[player] = nil
	runStartedAt[player] = nil
	playerMove[player] = nil
	playerJump[player] = nil
	killCooldown[player] = nil
end)

Remotes.RequestRespawn.OnServerEvent:Connect(function(player)
	createMarble(player, false)
end)

-- Klient sender: moveX, moveZ (world), jump (bool)
Remotes.PlayerInput.OnServerEvent:Connect(function(player, moveX, moveZ, jump)
	if typeof(moveX) ~= "number" or typeof(moveZ) ~= "number" then
		return
	end
	if not marbles[player] then
		return
	end

	-- Clamp for at undgå exploit / NaN
	if moveX ~= moveX or moveZ ~= moveZ then
		return
	end
	moveX = math.clamp(moveX, -1, 1)
	moveZ = math.clamp(moveZ, -1, 1)

	local move = Vector3.new(moveX, 0, moveZ)
	if move.Magnitude > 1 then
		move = move.Unit
	elseif move.Magnitude < 0.05 then
		move = Vector3.zero
	end
	playerMove[player] = move
	if jump == true then
		playerJump[player] = true
	end
end)

for _, desc in courseFolder:GetDescendants() do
	if desc:IsA("BasePart") and desc:GetAttribute("CheckpointIndex") then
		local cpIndex = desc:GetAttribute("CheckpointIndex") :: number
		desc.Touched:Connect(function(hit)
			if hit:GetAttribute("IsMarble") ~= true then
				return
			end
			local owner: Player? = nil
			for p, marble in marbles do
				if marble == hit then
					owner = p
					break
				end
			end
			if not owner then
				return
			end
			local current = lastCheckpoint[owner] or 0
			if cpIndex <= current then
				return
			end
			lastCheckpoint[owner] = cpIndex
			Remotes.CheckpointUpdated:FireClient(owner, cpIndex, checkpointCount)
		end)
	end
end

goalTrigger.Touched:Connect(function(hit)
	if hit:GetAttribute("IsMarble") ~= true then
		return
	end
	local owner: Player? = nil
	for p, marble in marbles do
		if hit == marble then
			owner = p
			break
		end
	end
	if not owner or finished[owner] then
		return
	end

	finished[owner] = true
	local started = runStartedAt[owner] or os.clock()
	local elapsed = os.clock() - started

	Remotes.RunComplete:FireClient(owner, elapsed)
	Remotes.GoalReached:FireClient(owner)

	task.delay(Config.Game.RestartDelayAfterGoal, function()
		if owner.Parent then
			lastCheckpoint[owner] = 0
			createMarble(owner, true)
		end
	end)
end)

local function killMarble(marblePart: BasePart)
	for player, marble in marbles do
		if marble == marblePart then
			local now = os.clock()
			if killCooldown[player] and now - killCooldown[player] < 0.75 then
				return
			end
			killCooldown[player] = now
			createMarble(player, false)
			return
		end
	end
end

ObstacleEngine.bindKillParts(courseFolder, killMarble)

RunService.Heartbeat:Connect(function()
	for player, marble in marbles do
		if not marble.Parent then
			continue
		end

		if marble.Position.Y < Config.RespawnY then
			createMarble(player, false)
			continue
		end

		local forceObj = driveForces[player]
		if forceObj then
			forceObj.Enabled = false
			forceObj.Force = Vector3.zero
		end

		if playerJump[player] then
			playerJump[player] = false
			if isGrounded(marble) then
				local velocity = marble.AssemblyLinearVelocity
				if velocity.Y <= 8 then
					marble.AssemblyLinearVelocity =
						Vector3.new(velocity.X, Config.Marble.JumpSpeed, velocity.Z)
				end
			end
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="17">
      <Properties>
        <string name="Name">ObstacleEngine</string>
        <string name="Source"><![CDATA[--[[
	ObstacleEngine.luau
	-------------------
	Bevægelige forhindringer. Nogle er LETHAL (KillsMarble) → respawn.
]]

local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local ObstacleEngine = {}

type Slider = {
	part: BasePart,
	origin: CFrame,
	axis: Vector3,
	amplitude: number,
	speed: number,
	phase: number,
}

type Spinner = {
	hub: BasePart,
	arm: BasePart,
	speed: number,
	phase: number,
	armHeight: number,
}

type Swinger = {
	part: BasePart,
	pivot: CFrame,
	speed: number,
	phase: number,
	maxAngle: number,
	length: number,
}

local sliders: { Slider } = {}
local spinners: { Spinner } = {}
local swingers: { Swinger } = {}
local started = false

local KILL_COLOR = Color3.fromRGB(220, 30, 40)
local KILL_NEON = Color3.fromRGB(255, 40, 60)

local function makePart(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

local function markLethal(p: BasePart)
	p:SetAttribute("KillsMarble", true)
	p.Color = KILL_NEON
	p.Material = Enum.Material.Neon
	-- Lille highlight så spilleren kan se faren
	local h = Instance.new("Highlight")
	h.FillColor = KILL_COLOR
	h.FillTransparency = 0.55
	h.OutlineColor = Color3.fromRGB(255, 120, 120)
	h.OutlineTransparency = 0.2
	h.Parent = p
end

function ObstacleEngine.addSlidingPlatform(
	parent: Instance,
	origin: CFrame,
	size: Vector3,
	axis: Vector3,
	amplitude: number,
	speed: number,
	phase: number?,
	color: Color3?,
	lethal: boolean?
): Part
	local p = makePart(parent, {
		Name = if lethal then "KillSlider" else "SlidingPlatform",
		Size = size,
		CFrame = origin,
		Color = color or Color3.fromRGB(220, 130, 55),
		Material = Enum.Material.Metal,
	})
	if lethal then
		markLethal(p)
	end
	table.insert(sliders, {
		part = p,
		origin = origin,
		axis = axis.Unit,
		amplitude = amplitude,
		speed = speed,
		phase = phase or 0,
	})
	return p
end

function ObstacleEngine.addElevator(
	parent: Instance,
	origin: CFrame,
	size: Vector3,
	amplitude: number,
	speed: number,
	phase: number?,
	color: Color3?,
	lethal: boolean?
): Part
	return ObstacleEngine.addSlidingPlatform(
		parent,
		origin,
		size,
		Vector3.yAxis,
		amplitude,
		speed,
		phase,
		color or Color3.fromRGB(90, 170, 220),
		lethal
	)
end

function ObstacleEngine.addSpinner(
	parent: Instance,
	hubCenter: Vector3,
	armLength: number,
	hubHeight: number,
	speed: number,
	phase: number?,
	lethal: boolean?
)
	local hub = makePart(parent, {
		Name = "SpinnerHub",
		Size = Vector3.new(3.5, hubHeight, 3.5),
		CFrame = CFrame.new(hubCenter),
		Color = Color3.fromRGB(100, 40, 40),
		Material = Enum.Material.Metal,
	})
	local armThickness = 2.4
	local arm = makePart(parent, {
		Name = "SpinnerArm",
		Size = Vector3.new(armLength * 2, armThickness, armThickness),
		CFrame = CFrame.new(hubCenter + Vector3.new(0, hubHeight * 0.5 + armThickness * 0.5, 0)),
		Color = Color3.fromRGB(255, 70, 70),
		Material = Enum.Material.Neon,
	})
	if lethal ~= false then
		-- Spinners er lethal som standard
		markLethal(arm)
		hub:SetAttribute("KillsMarble", true)
	end
	table.insert(spinners, {
		hub = hub,
		arm = arm,
		speed = speed,
		phase = phase or 0,
		armHeight = hubHeight * 0.5 + armThickness * 0.5,
	})
end

function ObstacleEngine.addSwingingHammer(
	parent: Instance,
	pivot: Vector3,
	length: number,
	speed: number,
	maxAngleDeg: number,
	phase: number?,
	lethal: boolean?
)
	local thickness = 3.2
	local p = makePart(parent, {
		Name = "SwingHammer",
		Size = Vector3.new(thickness, length, thickness),
		CFrame = CFrame.new(pivot) * CFrame.new(0, -length / 2, 0),
		Color = Color3.fromRGB(200, 90, 40),
		Material = Enum.Material.Metal,
	})
	makePart(parent, {
		Name = "SwingPivot",
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(pivot),
		Color = Color3.fromRGB(80, 80, 90),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	})
	if lethal ~= false then
		markLethal(p)
	end
	table.insert(swingers, {
		part = p,
		pivot = CFrame.new(pivot),
		speed = speed,
		phase = phase or 0,
		maxAngle = math.rad(maxAngleDeg),
		length = length,
	})
end

function ObstacleEngine.addBouncePad(parent: Instance, cf: CFrame, size: Vector3)
	local pad = makePart(parent, {
		Name = "BouncePad",
		Size = size,
		CFrame = cf,
		Color = Color3.fromRGB(120, 200, 255),
		Material = Enum.Material.Neon,
	})
	pad:SetAttribute("BouncePower", Config.Obstacles.BouncePower)
end

function ObstacleEngine.addIceStrip(parent: Instance, cf: CFrame, size: Vector3)
	local ice = makePart(parent, {
		Name = "IceStrip",
		Size = size,
		CFrame = cf,
		Color = Color3.fromRGB(180, 220, 255),
		Material = Enum.Material.Ice,
	})
	ice.CustomPhysicalProperties = PhysicalProperties.new(0.7, Config.Obstacles.IceFriction, 0.05, 1, 1)
end

function ObstacleEngine.bindBouncePads(folder: Folder)
	for _, desc in folder:GetDescendants() do
		if desc:IsA("BasePart") and desc:GetAttribute("BouncePower") then
			local power = desc:GetAttribute("BouncePower") :: number
			desc.Touched:Connect(function(hit)
				if not hit:IsA("BasePart") or hit:GetAttribute("IsMarble") ~= true then
					return
				end
				local vel = hit.AssemblyLinearVelocity
				if vel.Y > 18 then
					return
				end
				hit.AssemblyLinearVelocity = Vector3.new(vel.X, power, vel.Z)
			end)
		end
	end
end

--[[
	Binder alle KillsMarble-parts. onKill(marblePart) kaldes (med cooldown håndteret udefra anbefales).
]]
function ObstacleEngine.bindKillParts(folder: Folder, onKill: (BasePart) -> ())
	for _, desc in folder:GetDescendants() do
		if desc:IsA("BasePart") and desc:GetAttribute("KillsMarble") == true then
			desc.Touched:Connect(function(hit)
				if hit:IsA("BasePart") and hit:GetAttribute("IsMarble") == true then
					onKill(hit)
				end
			end)
		end
	end
end

function ObstacleEngine.start()
	if started then
		return
	end
	started = true

	RunService.Heartbeat:Connect(function()
		local t = os.clock()

		for _, s in sliders do
			local offset = math.sin(t * s.speed + s.phase) * s.amplitude
			s.part.CFrame = s.origin + s.axis * offset
		end

		for _, sp in spinners do
			local angle = t * sp.speed + sp.phase
			local armCenter = sp.hub.Position + Vector3.new(0, sp.armHeight, 0)
			sp.arm.CFrame = CFrame.new(armCenter) * CFrame.Angles(0, angle, 0)
		end

		for _, sw in swingers do
			local angle = math.sin(t * sw.speed + sw.phase) * sw.maxAngle
			sw.part.CFrame = sw.pivot * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -sw.length / 2, 0)
		end
	end)
end

return ObstacleEngine
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="18">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="19">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">CameraBootstrap</string>
          <string name="Source"><![CDATA[--[[
	CameraBootstrap.client.luau
	---------------------------
	Minimal kamera-script UDEN require/remotes.
	Sikrer at Client-fanen ikke sidder fast på blå himmel, hvis andre scripts fejler
	eller Streaming/Character mangler.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local function followMarble()
	local ball = workspace:FindFirstChild(player.Name .. "_Marble")
	if not (ball and ball:IsA("BasePart")) then
		return
	end

	local cam = workspace.CurrentCamera
	if not cam then
		return
	end

	-- Hvis MarbleControl allerede styrer kameraet, lader det gøre det
	if cam:GetAttribute("MarbleControlActive") == true then
		return
	end

	cam.CameraType = Enum.CameraType.Scriptable
	local pos = ball.Position
	cam.CFrame = CFrame.lookAt(pos + Vector3.new(0, 14, 28), pos + Vector3.new(0, 2, 0))
end

RunService.RenderStepped:Connect(followMarble)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="21">
        <Properties>
          <string name="Name">Hud</string>
          <string name="Source"><![CDATA[--[[
	Hud.client.luau — tid, checkpoints, afstand, debug
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local CourseState = require(Shared:WaitForChild("CourseState"))

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "MarbleHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function makeLabel(props: { [string]: any }): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.TextStrokeTransparency = 0.45
	t.Font = Enum.Font.GothamMedium
	for k, v in props do
		(t :: any)[k] = v
	end
	t.Parent = gui
	return t
end

makeLabel({
	Name = "Title",
	Position = UDim2.new(0, 24, 0, 24),
	Size = UDim2.new(0, 280, 0, 36),
	Font = Enum.Font.GothamBold,
	TextSize = 28,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.new(1, 1, 1),
	Text = "Marble Run",
})

local timerLabel = makeLabel({
	Name = "Timer",
	Position = UDim2.new(0, 24, 0, 64),
	Size = UDim2.new(0, 220, 0, 28),
	TextSize = 22,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(200, 230, 255),
	Text = "Tid: 0:00.0",
})

local checkpointLabel = makeLabel({
	Name = "Checkpoints",
	Position = UDim2.new(0, 24, 0, 96),
	Size = UDim2.new(0, 220, 0, 24),
	TextSize = 18,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(180, 210, 255),
	Text = "Checkpoint: 0/0",
})

local debugLabel = makeLabel({
	Name = "Debug",
	Position = UDim2.new(0, 24, 0, 128),
	Size = UDim2.new(0, 460, 0, 80),
	Font = Enum.Font.Code,
	TextSize = 14,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	TextColor3 = Color3.fromRGB(160, 255, 160),
	Text = "Debug...",
})

local goalLabel = makeLabel({
	Name = "GoalDistance",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -24, 0, 24),
	Size = UDim2.new(0, 260, 0, 40),
	TextSize = 20,
	TextXAlignment = Enum.TextXAlignment.Right,
	TextColor3 = Color3.fromRGB(255, 230, 140),
	Text = "Mål: —",
})

makeLabel({
	Name = "Hint",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -20),
	Size = UDim2.new(0.95, 0, 0, 36),
	TextSize = 16,
	TextColor3 = Color3.fromRGB(240, 245, 255),
	Text = "Rød neon = død · WASD · pile · Space · Enter · R",
})

local banner = makeLabel({
	Name = "Banner",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.35),
	Size = UDim2.new(0.7, 0, 0, 72),
	Font = Enum.Font.GothamBold,
	TextSize = 48,
	TextColor3 = Color3.fromRGB(255, 220, 80),
	TextTransparency = 1,
	Text = "MÅL NÅET!",
})

local function formatTime(seconds: number): string
	local minutes = math.floor(seconds / 60)
	local secs = seconds - minutes * 60
	return string.format("%d:%04.1f", minutes, secs)
end

local function showBanner(text: string)
	banner.TextTransparency = 0
	banner.Text = text
	task.delay(2.5, function()
		banner.TextTransparency = 1
	end)
end

Remotes.CourseInfo.OnClientEvent:Connect(function(payload)
	CourseState.applyCourseInfo(payload)
	checkpointLabel.Text = string.format("Checkpoint: 0/%d", payload.checkpointCount)
end)

Remotes.CheckpointUpdated.OnClientEvent:Connect(function(index: number, total: number)
	CourseState.setCheckpoint(index)
	checkpointLabel.Text = string.format("Checkpoint: %d/%d", index, total)
	showBanner("Checkpoint " .. index .. "!")
end)

Remotes.RunComplete.OnClientEvent:Connect(function(elapsed: number)
	CourseState.finishRace(elapsed)
	showBanner("MÅL! " .. formatTime(elapsed))
end)

Remotes.GoalReached.OnClientEvent:Connect(function()
	if not CourseState.lastFinishTime then
		showBanner("MÅL NÅET!")
	end
end)

RunService.RenderStepped:Connect(function()
	local elapsed = CourseState.getElapsed()
	if elapsed then
		timerLabel.Text = "Tid: " .. formatTime(elapsed)
	end

	local marbleInst = workspace:FindFirstChild(player.Name .. "_Marble")
	local w = UserInputService:IsKeyDown(Enum.KeyCode.W)
	local a = UserInputService:IsKeyDown(Enum.KeyCode.A)
	local s = UserInputService:IsKeyDown(Enum.KeyCode.S)
	local d = UserInputService:IsKeyDown(Enum.KeyCode.D)

	if marbleInst and marbleInst:IsA("BasePart") then
		local speed = Vector3.new(marbleInst.AssemblyLinearVelocity.X, 0, marbleInst.AssemblyLinearVelocity.Z).Magnitude
		local dist = if CourseState.goalPosition ~= Vector3.zero
			then (CourseState.goalPosition - marbleInst.Position).Magnitude
			else 0
		goalLabel.Text = string.format("Mål: %.0f m", dist)
		debugLabel.Text = string.format(
			"keys W%s A%s S%s D%s\nspeed=%.1f  pos=%.0f,%.0f,%.0f\n(Klik i spilvinduet hvis keys=false)",
			tostring(w),
			tostring(a),
			tostring(s),
			tostring(d),
			speed,
			marbleInst.Position.X,
			marbleInst.Position.Y,
			marbleInst.Position.Z
		)
	else
		debugLabel.Text = "Ingen marble på Client endnu..."
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="22">
        <Properties>
          <string name="Name">MarbleControl</string>
          <string name="Source"><![CDATA[--[[
	MarbleControl.client.luau
	-------------------------
	Smooth arcade-styring:
	- Input glattes (InputSmooth)
	- Hastighed lerper mod ønsket retning (Accel/Steer/Brake)
	- NetworkOwner = spiller → ingen input-lag fra server-roundtrip
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local CourseState = require(Shared:WaitForChild("CourseState"))

local marble: BasePart? = nil
local rawMove = Vector3.zero
local smoothMove = Vector3.zero
local cameraYaw = math.pi
local cameraPitch = 0.35
local jumpRequested = false
local snapCameraToGoal = false
local snapCameraOnce = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function expAlpha(rate: number, dt: number): number
	-- Frame-rate uafhængig lerp-faktor
	return 1 - math.exp(-rate * dt)
end

local function getCamera(): Camera
	local cam = workspace.CurrentCamera
	if not cam then
		cam = Instance.new("Camera")
		cam.Parent = workspace
		workspace.CurrentCamera = cam
	end
	return cam
end

local function cameraOffset(): Vector3
	local distance = Config.Camera.Distance
	local height = Config.Camera.Height
	return Vector3.new(
		math.sin(cameraYaw) * math.cos(cameraPitch) * distance,
		math.sin(cameraPitch) * distance + height * 0.25,
		math.cos(cameraYaw) * math.cos(cameraPitch) * distance
	)
end

local function applyCamera(ball: BasePart, immediate: boolean, dt: number)
	local cam = getCamera()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CameraSubject = ball
	cam:SetAttribute("MarbleControlActive", true)

	local desired = CFrame.lookAt(ball.Position + cameraOffset(), ball.Position + Vector3.new(0, 1.5, 0))
	if immediate then
		cam.CFrame = desired
	else
		cam.CFrame = cam.CFrame:Lerp(desired, expAlpha(9, dt))
	end
end

local function bindMarble(assigned: BasePart?)
	local ball = assigned
	if not (ball and ball:IsA("BasePart")) then
		ball = workspace:FindFirstChild(player.Name .. "_Marble") :: BasePart?
	end
	if not ball then
		return
	end
	marble = ball
	smoothMove = Vector3.zero
	rawMove = Vector3.zero
	cameraYaw = math.pi
	cameraPitch = 0.35
	snapCameraOnce = true
	CourseState.beginRace()
	applyCamera(ball, true, 0)

	-- Sørg for at DriveForce ikke kæmper imod vores velocity-styring
	local drive = ball:FindFirstChild("DriveForce")
	if drive and drive:IsA("VectorForce") then
		drive.Force = Vector3.zero
		drive.Enabled = false
	end
end

local function getCameraFlatLook(): Vector3
	local look = getCamera().CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.05 then
		return Vector3.new(0, 0, -1)
	end
	return flat.Unit
end

local function isGrounded(ball: BasePart): boolean
	rayParams.FilterDescendantsInstances = { ball }
	local radius = ball.Size.Y * 0.5
	local origin = ball.Position
	local direction = Vector3.new(0, -(radius + Config.Marble.GroundCheckPadding), 0)
	if workspace:Raycast(origin, direction, rayParams) then
		return true
	end
	local offsets = {
		Vector3.new(radius * 0.4, 0, 0),
		Vector3.new(-radius * 0.4, 0, 0),
		Vector3.new(0, 0, radius * 0.4),
		Vector3.new(0, 0, -radius * 0.4),
	}
	for _, offset in offsets do
		if workspace:Raycast(origin + offset, direction, rayParams) then
			return true
		end
	end
	return false
end

local function updateRawMoveFromKeys()
	local x, z = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		z -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		z += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		x -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		x += 1
	end

	local look = getCameraFlatLook()
	local right = Vector3.new(-look.Z, 0, look.X)
	local dir = (look * -z) + (right * x)
	if dir.Magnitude > 1 then
		dir = dir.Unit
	elseif dir.Magnitude > 0.01 then
		dir = dir.Unit * dir.Magnitude
	else
		dir = Vector3.zero
	end
	rawMove = dir
end

local function updateCameraFromKeys(dt: number)
	local yawInput = 0
	local pitchInput = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		yawInput += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		yawInput -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Up) then
		pitchInput += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Down) then
		pitchInput -= 1
	end
	if yawInput ~= 0 then
		cameraYaw += yawInput * Config.Camera.TurnSpeed * dt
	end
	if pitchInput ~= 0 then
		cameraPitch = math.clamp(cameraPitch + pitchInput * Config.Camera.PitchSpeed * dt, 0.15, 1.2)
	end
end

local function updateCameraSnapToGoal(dt: number)
	if not snapCameraToGoal or not marble then
		return
	end
	local delta = CourseState.goalPosition - marble.Position
	local flat = Vector3.new(delta.X, 0, delta.Z)
	if flat.Magnitude < 6 then
		snapCameraToGoal = false
		return
	end
	local targetYaw = math.atan2(-flat.X, -flat.Z)
	local diff = (targetYaw - cameraYaw + math.pi) % (2 * math.pi) - math.pi
	if math.abs(diff) < 0.04 then
		cameraYaw = targetYaw
		snapCameraToGoal = false
	else
		cameraYaw += math.clamp(diff, -Config.Camera.GoalSnapSpeed * dt, Config.Camera.GoalSnapSpeed * dt)
	end
end

--[[
	Kerne: smooth velocity-styring
	desiredVel = smoothMove * MaxSpeed
	Nuværende horisontal hastighed lerper mod desired (accel/steer),
	eller mod 0 når der ikke er input (brake).
]]
local function applySmoothDrive(ball: BasePart, dt: number)
	smoothMove = smoothMove:Lerp(rawMove, expAlpha(Config.Marble.InputSmooth, dt))
	if smoothMove.Magnitude < 0.02 then
		smoothMove = Vector3.zero
	end

	local vel = ball.AssemblyLinearVelocity
	local horizontal = Vector3.new(vel.X, 0, vel.Z)
	local newHorizontal: Vector3

	if smoothMove.Magnitude > 0.02 then
		local desired = smoothMove.Unit * (Config.Marble.MaxSpeed * math.clamp(smoothMove.Magnitude, 0, 1))
		-- Bland accel + steer: hurtigere drejning når vi allerede kører
		local rate = Config.Marble.AccelRate
		if horizontal.Magnitude > 4 then
			rate = math.max(rate, Config.Marble.SteerRate)
		end
		newHorizontal = horizontal:Lerp(desired, expAlpha(rate, dt))
	else
		newHorizontal = horizontal:Lerp(Vector3.zero, expAlpha(Config.Marble.BrakeRate, dt))
		if newHorizontal.Magnitude < 0.35 then
			newHorizontal = Vector3.zero
		end
	end

	ball.AssemblyLinearVelocity = Vector3.new(newHorizontal.X, vel.Y, newHorizontal.Z)

	-- Blød rotation (ser mere “rullende” ud)
	local angular = ball.AssemblyAngularVelocity
	local targetSpin = Vector3.new(-newHorizontal.Z, 0, newHorizontal.X) * 0.35
	ball.AssemblyAngularVelocity = angular:Lerp(targetSpin, expAlpha(6, dt))
end

local function tryJump(ball: BasePart)
	if not isGrounded(ball) then
		return
	end
	local vel = ball.AssemblyLinearVelocity
	if vel.Y > 6 then
		return
	end
	ball.AssemblyLinearVelocity = Vector3.new(vel.X, Config.Marble.JumpSpeed, vel.Z)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.R then
		Remotes.RequestRespawn:FireServer()
	elseif input.KeyCode == Enum.KeyCode.Return then
		snapCameraToGoal = true
	elseif input.KeyCode == Enum.KeyCode.Space then
		jumpRequested = true
	end
end)

Remotes.CourseInfo.OnClientEvent:Connect(function(payload)
	CourseState.applyCourseInfo(payload)
end)

Remotes.AssignMarble.OnClientEvent:Connect(function(assigned)
	bindMarble(assigned)
end)

task.defer(function()
	local found = workspace:WaitForChild(player.Name .. "_Marble", 10)
	if found and found:IsA("BasePart") then
		bindMarble(found)
	end
end)

RunService.RenderStepped:Connect(function(dt)
	-- Clamp dt så et hitch ikke skyder marble afsted
	dt = math.clamp(dt, 0, 1 / 20)

	updateRawMoveFromKeys()
	updateCameraFromKeys(dt)
	updateCameraSnapToGoal(dt)

	local ball = marble
	if not ball or not ball.Parent then
		return
	end

	if jumpRequested then
		jumpRequested = false
		tryJump(ball)
	end

	applySmoothDrive(ball, dt)

	local immediate = snapCameraOnce
	snapCameraOnce = false
	applyCamera(ball, immediate, dt)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="23">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
    <Item class="Part" referent="24">
      <Properties>
        <string name="Name">Baseplate</string>
        <bool name="Anchored">true</bool>
        <bool name="CanCollide">false</bool>
        <Vector3 name="Position">
          <X>0</X>
          <Y>-50</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>1</X>
          <Y>1</Y>
          <Z>1</Z>
        </Vector3>
        <float name="Transparency">1</float>
      </Properties>
    </Item>
  </Item>
</roblox>